NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/visual_learning
REDIS_URL=redis://localhost:6379
PORT=3001
WEB_ORIGIN=http://127.0.0.1:3000
AUTH_RATE_LIMIT_MODE=local
PASSWORD_RESET_RESPONSE_FLOOR_MS=250
MAX_REGENERATIONS_PER_HOUR=10
MAX_PROVIDER_CALLS_PER_HOUR=60
RENDER_CONCURRENCY=1
MAX_RENDERS_PER_HOUR=12

# Together AI is used by the pipeline worker when this key is set.
TOGETHER_API_KEY=
TOGETHER_API_BASE_URL=https://api.together.ai/v1
TOGETHER_TTS_MODEL=hexgrad/Kokoro-82M
TOGETHER_TTS_VOICE=af_bella
TOGETHER_ALIGNMENT_MODEL=openai/whisper-large-v3
TOGETHER_IMAGE_MODEL=prunaai/p-image-ideogram
TOGETHER_IMAGE_COST_USD=0.00225
TOGETHER_REQUEST_TIMEOUT_MS=60000
TOGETHER_MAX_RETRIES=2
