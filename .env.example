NODE_ENV=development
# Docker Compose binds PostgreSQL to this host port. Change both values together
# if 5433 is already in use.
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/visual_learning
REDIS_URL=redis://localhost:6379
PORT=3001
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Development-only value. Generate a distinct, high-entropy secret before any
# shared or production deployment.
AUTH_SESSION_SECRET=local-development-session-secret-change-before-deploy-1234567890
AUTH_RATE_LIMIT_MODE=local
PASSWORD_RESET_RESPONSE_FLOOR_MS=250
MAX_REGENERATIONS_PER_HOUR=10
MAX_PROVIDER_CALLS_PER_HOUR=60
RENDER_CONCURRENCY=1
MAX_RENDERS_PER_HOUR=12

# Local private S3-compatible storage (the MinIO service in docker-compose.yml).
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=visual-learning-private
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin123
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_ALLOW_INSECURE_ENDPOINT=true
SIGNED_URL_TTL_SECONDS=300
MAX_UPLOAD_BYTES=26214400

# The isolated Docling ingestion service. The token must be the same value in
# the pipeline worker and services/ingestion process, and must be at least 32 characters.
INGESTION_SERVICE_URL=http://127.0.0.1:8000
INGESTION_SERVICE_TOKEN=local-ingestion-service-token-change-before-deploy-1234567890

# Local pilot cohort for the composition and demonstration-video workflows.
# Replace the sample ID with the signed-in local teacher's user ID.
DEMONSTRATION_PILOT_ENABLED=true
DEMONSTRATION_PILOT_USER_IDS=01a0c303-4ea7-71b6-8718-633200abbdf9

# Prompt-to-video pilot (ST-105/ST-107; docs/prompt-to-video-pilot.md). Both
# settings default closed. ENABLED=true opens it to every user. Disabling
# accepts no new runs but lets active runs finish; USER_IDS (comma-separated
# UUIDs) then decides who can still see their runs.
ONE_SHOT_PILOT_ENABLED=false
ONE_SHOT_PILOT_USER_IDS=
# Prompt-to-video runs one user may start per rolling hour.
MAX_ONE_SHOT_RUNS_PER_HOUR=3
# ST-107. The run budget cap is the confirmed estimate times this tolerance.
ONE_SHOT_BUDGET_TOLERANCE=1.25
# ST-107. Brief calls (first brief plus revisions) allowed per run.
ONE_SHOT_MAX_BRIEF_REVISIONS=3
# ST-112 (ADR-015). Pipeline worker: new storyboards get a v2
# composition-planned design, and a prompt-to-video run then plans its
# visuals and generates that design's pictures. Off by default until the
# three proof lessons are reviewed (docs/cinema-reel.md, section 4).
CREATIVE_DESIGN_V2_DEFAULT=false

# Together AI is used by the pipeline worker when this key is set. Leave it
# blank to use the local mock providers; a real key permits paid provider calls
# only when a user explicitly starts the relevant generation action.
TOGETHER_API_KEY=
TOGETHER_API_BASE_URL=https://api.together.ai/v1
TOGETHER_TTS_MODEL=canopylabs/orpheus-3b-0.1-ft
TOGETHER_TTS_VOICE=tara
TOGETHER_TTS_COST_USD_PER_MILLION_CHARACTERS=15
TOGETHER_ALIGNMENT_MODEL=nvidia/parakeet-tdt-0.6b-v3
TOGETHER_IMAGE_MODEL=prunaai/p-image-ideogram
TOGETHER_IMAGE_COST_USD=0.00225
TOGETHER_REQUEST_TIMEOUT_MS=60000
TOGETHER_MAX_RETRIES=8

# Optional renderer tuning. Uncomment only when the local browser executable
# or the default five-minute render deadline is unsuitable.
# RENDER_BROWSER_EXECUTABLE=C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe
# RENDER_TIMEOUT_SECONDS=300
