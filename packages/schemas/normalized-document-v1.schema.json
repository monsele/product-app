                },
                "required": [
                  "id",
                  "sectionId",
                  "order",
                  "pageStart",
                  "kind",
                  "items"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/definitions/NormalizedDocument/properties/id"
                  },
                  "sectionId": {
                    "$ref": "#/definitions/NormalizedDocument/properties/id"
                  },
                  "order": {
                    "$ref": "#/definitions/NormalizedDocument/properties/blocks/items/anyOf/0/properties/order"
                  },
                  "pageStart": {
                    "$ref": "#/definitions/NormalizedDocument/properties/sections/items/properties/pageStart"
                  },
                  "pageEnd": {
                    "$ref": "#/definitions/NormalizedDocument/properties/sections/items/properties/pageEnd"
                  },
                  "boundingBox": {
                    "$ref": "#/definitions/NormalizedDocument/properties/blocks/items/anyOf/0/properties/boundingBox"
                  },
                  "kind": {
                    "type": "string",
                    "const": "equation"
                  },
                  "latex": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20000
