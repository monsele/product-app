      "required": [
        "schemaVersion",
        "id",
        "sourceDocumentId",
        "parsedDocumentVersion",
        "language",
        "pageCount",
        "sections",
        "blocks",
        "figures",
        "tables",
        "warnings"
      ],
      "additionalProperties": false
    }
