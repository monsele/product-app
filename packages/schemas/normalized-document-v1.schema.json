        "warnings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "unknown_block",
                  "low_ocr_quality",
                  "missing_caption",
                  "malformed_table",
                  "uncertain_reading_order",
                  "duplicate_reading_order"
