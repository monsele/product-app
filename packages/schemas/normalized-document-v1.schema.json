                "$ref": "#/definitions/NormalizedDocument/properties/id"
              },
              "blockId": {
                "$ref": "#/definitions/NormalizedDocument/properties/id"
              },
              "figureId": {
                "$ref": "#/definitions/NormalizedDocument/properties/id"
              },
              "tableId": {
                "$ref": "#/definitions/NormalizedDocument/properties/id"
              }
            },
            "required": ["code", "severity", "message", "pageStart"],
            "additionalProperties": false
          },
          "maxItems": 10000
