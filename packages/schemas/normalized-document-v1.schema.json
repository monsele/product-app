                "required": [
                  "id",
                  "sectionId",
                  "order",
                  "pageStart",
                  "kind",
                  "latex"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/definitions/NormalizedDocument/properties/id"
                  },
                  "sectionId": {
                    "$ref": "#/definitions/NormalizedDocument/properties/id"
                  },
                  "order": {
                    "$ref": "#/definitions/NormalizedDocument/properties/blocks/items/anyOf/0/properties/order"
                  },
                  "pageStart": {
                    "$ref": "#/definitions/NormalizedDocument/properties/sections/items/properties/pageStart"
                  },
                  "pageEnd": {
                    "$ref": "#/definitions/NormalizedDocument/properties/sections/items/properties/pageEnd"
