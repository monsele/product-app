{
  "$ref": "#/definitions/LessonSpec",
  "definitions": {
    "LessonSpec": {
      "type": "object",
      "properties": {
        "schemaVersion": { "type": "string", "const": "1.7" },
        "lessonId": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "projectId": { "$ref": "#/definitions/LessonSpec/properties/lessonId" },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "subject": { "type": "string", "minLength": 1, "maxLength": 200 },
        "audience": {
          "type": "object",
          "properties": {
            "ageBand": {
              "type": "string",
              "enum": ["8-10", "11-13", "14-16", "adult-beginner"]
            },
            "difficulty": {
              "type": "string",
              "enum": ["introductory", "intermediate"]
            },
            "priorKnowledge": {
              "type": "array",
              "items": { "type": "string", "minLength": 1, "maxLength": 300 },
              "maxItems": 20
            }
          },
          "required": ["ageBand", "difficulty", "priorKnowledge"],
          "additionalProperties": false
        },
        "targetDurationSeconds": { "type": "number", "enum": [180, 300, 420] },
        "tone": {
          "type": "string",
          "enum": ["friendly", "academic", "conversational"]
        },
        "themeId": { "type": "string", "const": "mvp-default" },
        "objectiveIds": {
          "type": "array",
          "items": { "$ref": "#/definitions/LessonSpec/properties/lessonId" },
          "minItems": 1,
          "maxItems": 50
        },
        "voice": {
          "type": "object",
          "properties": {
            "providerVoiceId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "speakingRate": { "type": "number", "minimum": 0.5, "maximum": 2 }
          },
          "required": ["providerVoiceId", "speakingRate"],
          "additionalProperties": false
        },
        "scenes": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/definitions/LessonSpec/properties/lessonId"
                  },
                  "order": { "type": "integer", "exclusiveMinimum": 0 },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "narration": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 5000
                  },
                  "durationSeconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 300
                  },
                  "onScreenText": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "maxItems": 12
                  },
                  "transition": {
                    "type": "string",
                    "enum": ["cut", "fade", "slide"]
                  },
                  "assetBindings": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "assetId": {
                          "$ref": "#/definitions/LessonSpec/properties/lessonId"
                        },
                        "role": {
                          "type": "string",
                          "enum": [
                            "background",
                            "diagram",
                            "icon",
                            "illustration",
                            "photo",
                            "supporting"
                          ]
                        },
                        "altText": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        },
                        "slot": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        }
                      },
                      "required": ["assetId", "role"],
                      "additionalProperties": false
                    },
                    "maxItems": 20
                  },
                  "sourceRefs": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "documentId": {
                          "$ref": "#/definitions/LessonSpec/properties/lessonId"
                        },
                        "parsedDocumentVersion": {
                          "type": "integer",
                          "exclusiveMinimum": 0
                        },
                        "pageStart": {
                          "type": "integer",
                          "exclusiveMinimum": 0
                        },
                        "pageEnd": { "type": "integer", "exclusiveMinimum": 0 },
                        "sectionId": {
                          "$ref": "#/definitions/LessonSpec/properties/lessonId"
                        },
                        "blockIds": {
                          "type": "array",
                          "items": {
                            "$ref": "#/definitions/LessonSpec/properties/lessonId"
                          },
                          "minItems": 1,
                          "maxItems": 100
                        },
                        "figureIds": {
                          "type": "array",
                          "items": {
                            "$ref": "#/definitions/LessonSpec/properties/lessonId"
                          },
                          "maxItems": 100
                        },
                        "tableIds": {
                          "type": "array",
                          "items": {
                            "$ref": "#/definitions/LessonSpec/properties/lessonId"
                          },
                          "maxItems": 100
                        }
                      },
                      "required": [
                        "documentId",
                        "parsedDocumentVersion",
                        "pageStart",
                        "blockIds"
                      ],
                      "additionalProperties": false
                    },
                    "minItems": 1,
                    "maxItems": 100
                  },
                  "generatedAdditions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "analogy",
                            "example",
                            "illustration",
                            "clarification"
                          ]
                        },
                        "content": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 2000
                        },
                        "rationale": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 500
                        }
                      },
                      "required": ["kind", "content", "rationale"],
                      "additionalProperties": false
                    },
                    "maxItems": 20
                  },
                  "template": { "type": "string", "const": "hook" },
                  "visual": {
                    "type": "object",
                    "properties": {
                      "question": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "prompt": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 48
                      },
                      "supportingElements": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 12
                        },
                        "maxItems": 3
                      }
                    },
                    "required": ["question"],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "id",
                  "order",
                  "narration",
                  "durationSeconds",
                  "onScreenText",
                  "transition",
                  "assetBindings",
                  "sourceRefs",
                  "generatedAdditions",
                  "template",
                  "visual"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/definitions/LessonSpec/properties/lessonId"
                  },
