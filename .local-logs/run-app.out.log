@avlp/pipeline-worker:dev: {"timestamp":"2026-10-07T22:01:43.717Z","level":"info","event":"provider.together.response","fields":{"provider":"together","endpoint":"/chat/completions","response":{"httpStatus":200,"contentType":"text/event-stream","providerRequestId":"9ea91cf7-aws_ew1","model":"moonshotai/Kimi-K3","text":"\n{\n  \"schemaVersion\": \"scene-regeneration-v1\",\n  \"mode\": \"regenerate\",\n  \"scene\": {\n    \"id\": \"01a1185b-0553-7622-90af-3f49133e3206\",\n    \"order\": 6,\n    \"template\": \"labelled-diagram\",\n    \"title\": \"The Bidirectional Sleep–Mental Health Loop\",\n    \"narration\": \"The relationship between sleep and mental health is not one-directional; it is a loop. Anxiety and depression disturb sleep architecture from one side. From the other, insufficient or disrupted sleep degrades emotional regulation. The documented consequences of sleep deficiency include increased anxiety, depressive symptoms, heightened emotional reactivity, poorer stress tolerance, and diminished positive emotion. The clinical implication is threefold, and worth stating explicitly. Sleep disruption is simultaneously a symptom of psychiatric illness, a perpetuating factor that worsens it, and a therapeutic entry point. Treating sleep is therefore never merely symptomatic management; it is an intervention on the loop itself. The same architecture appears in training contexts as recovery debt. Functional fatigue represents productive adaptation. When stress repeatedly exceeds recovery capacity, the loop degrades: non-functional overreaching, then overtraining syndrome. The bidirectional principle holds—sleep disruption remains simultaneously symptom, perpetuating factor, and entry point for intervention.\",\n    \"onScreenText\": [],\n    \"durationSeconds\": 52,\n    \"transition\": \"slide\",\n    \"visual\": {\n      \"kind\": \"shapes\",\n      \"shape\": \"cycle\",\n      \"labels\": [\n        {\n          \"anchor\": \"top\",\n          \"id\": \"anxiety-depression\",\n          \"text\": \"Anxiety and depression disturb sleep architecture\"\n        },\n        {\n          \"anchor\": \"right\",\n          \"id\": \"sleep-loss\",\n          \"text\": \"Insufficient sleep degrades emotional regulation\"\n        },\n        {\n          \"anchor\": \"bottom\",\n          \"id\": \"symptom\",\n          \"text\": \"Symptom of psychiatric illness\"\n        },\n        {\n          \"a","textChunks":["\n{\n  \"schemaVersion\": \"scene-regeneration-v1\",\n  \"mode\": \"regenerate\",\n  \"scene\": {\n    \"id\": \"01a1185b-0553-7622-90af-3f49133e3206\",\n    \"order\": 6,\n    \"template\": \"labelled-diagram\",\n    \"title\": \"The Bidirectional Sleep–Mental Health Loop\",\n    \"narration\": \"The relationship between sleep and mental health is not one-directional; it is a loop. Anxiety and depression disturb sleep architecture from one side. From the other, insufficient or disrupted sleep degrades emotional regulation. The documented consequences of sleep deficiency include increased anxiety, depressive symptoms, heightened emotional reactivity, poorer stress tolerance, and diminished positive emotion. The clinical implication is threefold, and worth stating explicitly. Sleep disruption is simultaneously a symptom of psychiatric illness, a perpetuating factor that worsens it, and a therapeutic entry point. Treating sleep is therefore never merely symptomatic management; it is an intervention on the loop itself. The same architecture appears in training contexts as recovery debt. Functional fatigue represents productive adaptation. When stress repeatedly exceeds recovery capacity, the loop degrades: non-functional overreaching, then overtraining syndrome. The bidirectional principle holds—sleep disruption remains simultaneously symptom, perpetuating factor, and entry point for intervention.\",\n    \"onScreenText\": [],\n    \"durationSeconds\": 52,\n    \"transition\": \"slide\",\n    \"visual\": {\n      \"kind\": \"shapes\",\n      \"shape\": \"cycle\",\n      \"labels\": [\n        {\n          \"anchor\": \"top\",\n          \"id\": \"anxiety-depression\",\n          \"text\": \"Anxiety and depression disturb sleep architecture\"\n        },\n        {\n          \"anchor\": \"right\",\n          \"id\": \"sleep-loss\",\n          \"text\": \"Insufficient sleep degrades emotional regulation\"\n        },\n        {\n          \"anchor\": \"bottom\",\n          \"id\": \"symptom\",\n          \"text\": \"Symptom of psychiatric illness\"\n        },\n        {\n          \"a","nchor\": \"left\",\n          \"id\": \"perpetuating\",\n          \"text\": \"Perpetuating factor\"\n        },\n        {\n          \"anchor\": \"center\",\n          \"id\": \"therapeutic\",\n          \"text\": \"Therapeutic entry point\"\n        }\n      ]\n    },\n    \"narrationBlockIds\": [\n      \"01a11853-2f5a-76f0-a0a6-c6312cda3e81\"\n    ],\n    \"sourceBlockIds\": [\n      \"6b86335a-0ad4-72b2-bb3f-d7433f3a0ea3\"\n    ],\n    \"generatedAdditions\": [\n      {\n        \"kind\": \"clarification\",\n        \"content\": \"Recovery debt in training: the progression from functional fatigue to non-functional overreaching and overtraining syndrome when stress repeatedly exceeds recovery capacity\",\n        \"rationale\": \"Extends the bidirectional loop concept to athletic training contexts, illustrating how the same principle of bidirectional degradation applies when recovery capacity is exceeded. This bridges the clinical sleep-mental health model with exercise physiology.\"\n      }\n    ],\n    \"assetRequirements\": [],\n    \"estimatedSeconds\": 52\n  }\n}\n"],"textChunksTruncated":false,"textCharacters":3015,"reasoningCharacters":0,"finishReason":"stop","inputTokens":"[REDACTED]","outputTokens":"[REDACTED]"},"retries":0,"latencyMs":9881,"service":"pipeline-worker","correlationId":"01a11850-8e35-73cc-a9b5-000a01137296"}}
