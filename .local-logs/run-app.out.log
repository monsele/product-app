@avlp/pipeline-worker:dev: {"timestamp":"2026-10-07T21:46:35.005Z","level":"info","event":"provider.together.response","fields":{"provider":"together","endpoint":"/chat/completions","response":{"httpStatus":200,"contentType":"text/event-stream","providerRequestId":"6e1b0bc9-aws_ew1","model":"moonshotai/Kimi-K3","text":"{\"repairs\":[{\"blockIndex\":3,\"sentenceIndex\":3,\"sentences\":[{\"text\":\"Sustained short sleeping patterns correlate with elevated blood pressure, coronary artery pathology, and cerebrovascular events.\"}]},{\"blockIndex\":6,\"sentenceIndex\":4,\"sentences\":[{\"text\":\"Research connects that persistent state to cognitive decline, emotional disturbances, metabolic dysfunction, heightened inflammatory markers, compromised immune regulation, cardiovascular pathology, increased injury risk, and diminished physical capacity.\"}]},{\"blockIndex\":6,\"sentenceIndex\":7,\"sentences\":[{\"text\":\"A mentally drained office worker will likely gain more from taking a walk than from remaining in bed while browsing social feeds.\"}]}]}","textChunks":["{\"repairs\":[{\"blockIndex\":3,\"sentenceIndex\":3,\"sentences\":[{\"text\":\"Sustained short sleeping patterns correlate with elevated blood pressure, coronary artery pathology, and cerebrovascular events.\"}]},{\"blockIndex\":6,\"sentenceIndex\":4,\"sentences\":[{\"text\":\"Research connects that persistent state to cognitive decline, emotional disturbances, metabolic dysfunction, heightened inflammatory markers, compromised immune regulation, cardiovascular pathology, increased injury risk, and diminished physical capacity.\"}]},{\"blockIndex\":6,\"sentenceIndex\":7,\"sentences\":[{\"text\":\"A mentally drained office worker will likely gain more from taking a walk than from remaining in bed while browsing social feeds.\"}]}]}"],"textChunksTruncated":false,"textCharacters":708,"reasoningCharacters":0,"finishReason":"stop","inputTokens":"[REDACTED]","outputTokens":"[REDACTED]"},"retries":0,"latencyMs":3956