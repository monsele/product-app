s\" },\n          { \"id\": \"learning-judgement-control\", \"label\": \"Learning, decision-making, emotional control deteriorate\" },\n          { \"id\": \"mood-anxiety\", \"label\": \"Positive mood suppressed; anxiety elevated\" }\n        ],\n        \"connections\": [\n          { \"from\": \"sleep-loss\", \"to\": \"cognitive-affective-degradation\" },\n          { \"from\": \"cognitive-affective-degradation\", \"to\": \"attention-reaction-memory\" },\n          { \"from\": \"cognitive-affective-degradation\", \"to\": \"learning-judgement-control\" },\n          { \"from\": \"cognitive-affective-degradation\", \"to\": \"mood-anxiety\" }\n        ]\n      },\n      \"estimatedSeconds\": 39,\n      \"transition\": \"cut\",\n      \"sourceBlockIds\": [\n        \"9eec6c71-abc2-7bc6-91ca-cd15dc252fb4\"\n      ],\n      \"generatedAdditions\": [],\n      \"assetRequirements\": [\n        {\n     ","     \"slot\": \"cause-1-icon\",\n          \"purpose\": \"Icon depicting sleep loss or deprivation as the causal node.\"\n        },\n        {\n          \"slot\": \"mechanism-icon\",\n          \"purpose\": \"Icon depicting degradation of cognitive and affective processing.\"\n        },\n        {\n          \"slot\": \"effect-1-icon\",\n          \"purpose\": \"Icon for attention, reaction time, and working-memory deficits.\"\n        },\n        {\n          \"slot\": \"effect-2-icon\",\n          \"purpose\": \"Icon for impaired learning, judgement, and emotional control.\"\n        },\n        {\n          \"slot\": \"effect-3-icon\",\n          \"purpose\": \"Icon for suppressed positive mood and elevated anxiety.\"\n        }\n      ]\n    },\n    {\n      \"template\": \"cause-effect\",\n      \"title\": \"Cardiovascular Strain: A Cumulative Temporal Trajectory\",\n      \"narrationBlockIds\": [\n        \"01a11853-2f5a-7917-b0e8-609fbb64b2f1\"\n      ],\n      \"onScreenText\": [\n        \"One poor night ≠ heart disease; risk compounds over months and years.\