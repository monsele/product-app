xt\":\"Righteousness as a gift from God\",\"sourceBlockIds\":[\"27f538fc-9519-76f8-9022-da2e14ff8e7c\",\"ddd8a660-bfd1-71fb-bad2-44b3fca1b2c1\"]},{\"text\":\"Righteousness as a harvest of what is done\",\"sourceBlockIds\":[\"27f538fc-9519-76f8-9022-da2e14ff8e7c\",\"679469fb-589a-7a5a-9a19-e707aa9eb8b5\",\"ddd8a660-bfd1-71fb-bad2-44b3fca1b2c1\"]},{\"text\":\"Sowing and reaping in 2 Corinthians 9:6–10\",\"sourceBlockIds\":[\"679469fb-589a-7a5a-9a19-e707aa9eb8b5\"]},{\"text\":\"Obedience as the soil in which gift-righteousness produces a crop\",\"sou","rceBlockIds\":[\"f7364a17-0188-724b-9a2b-3100f27e2606\",\"ddd8a660-bfd1-71fb-bad2-44b3fca1b2c1\"]},{\"text\":\"Vertical versus horizontal righteousness\",\"sourceBlockIds\":[\"2af4b3fd-3236-7fe7-b029-ff96a9ea899f\"]},{\"text\":\"Tzedakah: personal morality, justice, and charity\",\"sourceBlockIds\":[\"ae46abef-303d-74c7-aaed-ae3b93115a06\",\"6353155b-4af1-7602-beb9-ba44a3752dac\",\"54b12e03-243c-7c0a-b6f9-56810778b4e4\",\"08211261-1830-7557-9461-ea0c129d2a58\"]}],\"prerequisiteKnowledge\":[{\"text\":\"Basic awareness that believers understand righteousness as a gift of God\",\"sourceBlockIds\":[\"27f538fc-9519-76f8-9022-da2e14ff8e7c\"]},{\"text\":\"Working familiarity with the language of sowing, reaping, and harvest\",\"sourceBlockIds\":[\"679469fb-589a-7a5a-9a19-e707aa9eb8b5\"]},{\"text\":\"General familiarity with biblical examples such as David, Abraham, and the Good Samaritan\",\"sourceBlockIds\":[\"2af4b3fd-3236-7fe7-b029-ff96a9ea899f\",\"54b12e03-243c-7c0a-b6f9-56810778b4e4\",\"08211261-1830-7557-9461-ea0c129d2a58\"]}],\"vocabulary\":[{\"term\":\"righteousness as a gift\",\"definition\":\"The righteousness given by God to all who believe\",\"sourceBlockIds\":[\"ddd8a660-bfd1-71fb-bad2-44b3fca1b2c1\"]},{\"term\":\"righteousness as a harvest\",\"definition\":\"Righteousness seen as the result or crop of what is done in obedience\",\"sourceBlockIds\":[\"27f538fc-9519-76f8-9022-da2e14ff8e7c\",\"ddd8a660-bfd1-71fb-bad2-44b3fca1b2c1\"]},{\"term\":\"tzedakah\",\"definition\":\"The Hebrew word for righteousness, encompassing personal morality, justice, and charity\",\"sourceBlockIds\":[\"ae46abef-303d-74c7-aaed-ae3b93115a06\",\"d574c819-f603-763f-a6b0-6e6897aa1271\"]},{\"term\":\"vertical righteousness\",\"definition\":\"Righteousness considered before God, where human efforts are like filthy rags\",\"sourceBlockIds\":[\"2af4b3fd-3236-7fe7-b029-ff96a9ea899f\"]},{\"term\":\"horizontal righteousness\",\"definition\":\"Righteousness seen before people through visible works\",\"sourceBlockIds\":[\"2af4b3fd-3236-7fe7-b029-ff96a9ea899f\"]},{\"term\":\"harvest of your righteousness\",\"definition\":\"","The increase Paul links to supplied and multiplied seed for sowing\",\"sourceBlockIds\":[\"679469fb-589a-7a5a-9a19-e707aa9eb8b5\"]}],\"misconceptions\":[{\"misconception\":\"If righteousness is a gift, there is nothing further to work out.\",\"correction\":\"The source presents two manifestations: gift-righteousness and harvest-righteousness, so believers also need righteousness seen as a harvest.\",\"sourceBlockIds\":[\"27f538fc-9519-76f8-9022-da2e14ff8e7c\",\"ddd8a660-bfd1-71fb-bad2-44b3fca1b2c1\"]},{\"misconception\":\"Harvest-righteousness earns relationship with God.\",\"correction\":\"The source says it is not a prerequisite to relationship with God but a fruit of that relationship.\",\"sourceBlockIds\":[\"ddd8a660-bfd1-71fb-bad2-44b3fca1b2c1\"]},{\"misconception\":\"Visible works do not matter if faith is real.\",\"correction\":\"The source says that horizontally before men, faith can only be seen through visible works.\",\"sourceBlockIds\":[\"2af4b3fd-3236-7fe7-b029-ff96a9ea899f\"]},{\"misconception\":\"Tzedakah means only private moral purity.\",\"correction\":\"The source defines tzedakah across three dimensions: personal morality, justice, and charity.\",\"sourceBlockIds\":[\"ae46abef-303d-74c7-aaed-ae3b93115a06\",\"6353155b-4af1-7602-beb9-ba44a3752dac\",\"54b12e03-243c-7c0a-b6f9-56810778b4e4\",\"08211261-1830-7557-9461-ea0c129d2a58\"]}],\"assessmentQuestions\":[{\"question\":\"In your own words, what is the difference between righteousness as a gift and righteousness as a harvest?\",\"sourceBlockIds\":[\"27f538fc-9519-76f8-9022-da2e14ff8e7c\",\"ddd8a660-bfd1-71fb-bad2-44b3fca1b2c1\"]},{\"question\":\"According to 2 Corinthians 9:6–10, what happens to the one who sows sparingly and the one who sows bountifully?\",\"sourceBlockIds\":[\"679469fb-589a-7a5a-9a19-e707aa9eb8b5\"]},{\"question\":\"Why does the source say harvest-righteousness is not a prerequisite to relationship with God?\",\"sourceBlockIds\":[\"ddd8a660-bfd1-71fb-bad2-44b3fca1b2c1\"]},{\"question\":\"How does the David example show the difference between vertical and horizontal righteo","usness?\",\"sourceBlockIds\":[\"2af4b3fd-3236-7fe7-b029-ff96a9ea899f\"]},{\"question\":\"Name the three dimensions of tzedakah and give one example of justice or charity from the source.\",\"sourceBlockIds\":[\"ae46abef-303d-74c7-aaed-ae3b93115a06\",\"54b12e03-243c-7c0a-b6f9-56810778b4e4\",\"08211261-1830-7557-9461-ea0c129d2a58\"]},{\"question\":\"What is one area of obedience where you could 'work out' gift-righteousness into a visible harvest this week?\",\"sourceBlockIds\":[\"ddd8a660-bfd1-71fb-bad2-44b3fca1b2c1\",\"f7364a17-0188-724b-9a2b-3100f27e2606\"]}],\"focusCoverage\":{\"status\":\"covered\"}}"],"textChunksTruncated":false,"textCharacters":6577,"reasoningCharacters":0,"finishReason":"stop","inputTokens":"[REDACTED]","outputTokens":"[REDACTED]"},"retries":0,"latencyMs":31019,"service":"pipeline-worker","correlationId":"01a14b40-ac07-7476-80b7-844b8c6ce013"}}
