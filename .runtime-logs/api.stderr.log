      `{"lessonVersionId":"01a0cb46-449b-7dcb-ba9d-6c18b06e8f1f","lessonVersionContentHash":"9dd9a1f9081e99334d59d31212c1267d4b30db1432cbfd95497dbaeed25ba3b7","identityPolicy":"canonical-json-v1","validationRunId":"01a0cb22-56ac-7a95-b662-e00482cbbd50","validationInputHash":"5c636e095eacc2c3e1564a7c4a178295e7720fa21ffd37ba70bb1721aea0362d","sceneLibraryVersion":"mvp-v1","schemaVersion":1,"approach":"standard","audio":[{"sceneId":"01a0cadc-f79e-7747-8e44-ae7329d88b84","storageKey":"users/01a0c938-7551-7405-a9e1-4db43e6bc491/projects/01a0cacc-4547-7835-b7c4-fcd924b96a92/audio/01a0cadc-f79e-7747-8e44-ae7329d88b84/86a2186040779044b73f1a77258e57ba5093bc9911f12affb3c1790b723ebceb.wav","checksumSha256":"cb4b206c606c98204f8655e6100401e45f91dd4f807c5dbd8ff8f45ad7a25416","contentType":"audio/wav"},{"sceneId":"01a0cadc-f79e-729a-8129-bfaf48faeb59","storageKey":"users/01a0c938-7551-7405-a9e1-4db43e6bc491/projects/01a0cacc-4547-7835-b7c4-fcd924b96a92/audio/01a0cadc-f79e-729a-8129-bfaf48faeb59/7829676d4ad167dfb5282a1b9b6a15a32a118005318503e2e56d5d5705624fee.wav","checksumSha256":"7b457605f0b3e5af27ee0c50ee957986832f0ece309d81a0ccb79cb5bfb18c2f","contentType":"audio/wav"},{"sceneId":"01a0cadc-f79e-7354-95cb-9e0b6787e590","storageKey":"users/01a0c938-7551-7405-a9e1-4db43e6bc491/projects/01a0cacc-4547-7835-b7c4-fcd924b96a92/audio/01a0cadc-f79e-7354-95cb-9e0b6787e590/e7f116ec9a91cfac113e2b34e60889403bc8073e4ce542473d4dccf1ce4c6c44.wav","checksumSha256":"35bef5ea133dcb07df086748774596bc48c36549237f6d13eb94fd509c2d5422","contentType":"audio/wav"},{"sceneId":"01a0cadc-f79e-7dba-8053-24768f2d1aca","storageKey":"users/01a0c938-7551-7405-a9e1-4db43e6bc491/projects/01a0cacc-4547-7835-b7c4-fcd924b96a92/audio/01a0cadc-f79e-7dba-8053-24768f2d1aca/3a63e0e11f02b104e79df7048a55e20ead5154fdf167b7415fc07fb27c0289d5.wav","checksumSha256":"736920cd131ab907667b53ef1f70c1afcccab984578628a80b303170abb4ddd3","contentType":"audio/wav"},{"sceneId":"01a0cadc-f79e-7aae-a0b7-c95171972638","storageKey":"users/01a0c938-7551-7405-a9e1-4db43e6bc491/projects/01a0cacc-4547-7835-b7c4-fcd924b96a92/audio/01a0cadc-f79e-7aae-a0b7-c95171972638/cbbdea97897c554a714ed6184ca8e0b8e9578563ea0a5e4ccf5db22484821100.wav","checksumSha256":"227f44cf3cedac5bb53246c44749f69e6574aa5f1feb375ec8c777c891662f79","contentType":"audio/wav"},{"sceneId":"01a0cadc-f79e-7314-8fb8-ec7b7b8fa0d7","storageKey":"users/01a0c938-7551-7405-a9e1-4db43e6bc491/projects/01a0cacc-4547-7835-b7c4-fcd924b96a92/audio/01a0cadc-f79e-7314-8fb8-ec7b7b8fa0d7/1a4bd52419fcdf345a739b6629e4abb1a136e60c84e7a5de911e08a372a184a2.wav","checksumSha256":"a6b83a69e3fdbb5f906e7f0f0e1d666a03a3136b18abfc641817db1908da5f9c","contentType":"audio/wav"},{"sceneId":"01a0cadc-f79e-76a9-a2bc-1f81bf3e8af1","storageKey":"users/01a0c938-7551-7405-a9e1-4db43e6bc491/projects/01a0cacc-4547-7835-b7c4-fcd924b96a92/audio/01a0cadc-f79e-76a9-a2bc-1f81bf3e8af1/1bd38da964e844c742341f5dca85be62f630d2c07156624c9eae5fe0d2187802.wav","checksumSha256":"fdc13e9a53b2f6bb1050f2a79df826e90a5c2adbffd129d6b6bad0392f6adaca","contentType":"audio/wav"}],"captions":[{"sceneId":"01a0cadc-f79e-7747-8e44-ae7329d88b84","startFrame":0,"endFrame":148,"text":"What if one word meant righteousness, justice, and generosity at the same time?"},{"sceneId":"01a0cadc-f79e-7747-8e44-ae7329d88b84","startFrame":148,"endFrame":274,"text":"Would it change how you see your faith and your money?"},{"sceneId":"01a0cadc-f79e-7747-8e44-ae7329d88b84","startFrame":274,"endFrame":354,"text":"Let's explore the Hebrew idea of Tzedakah."},{"sceneId":"01a0cadc-f79e-729a-8129-bfaf48faeb59","startFrame":374,"endFrame":454,"text":"Every believer has two kinds of righteousness."},{"sceneId":"01a0cadc-f79e-729a-8129-bfaf48faeb59","startFrame":458,"endFrame":540,"text":"The first is a gift received by grace through faith."},{"sceneId":"01a0cadc-f79e-729a-8129-bfaf48faeb59","startFrame":545,"endFrame":622,"text":"It is a fixed legal credit that never changes."},{"sceneId":"01a0cadc-f79e-729a-8129-bfaf48faeb59","startFrame":629,"endFrame":715,"text":"The second is a harvest that can grow and multiply."},{"sceneId":"01a0cadc-f79e-729a-8129-bfaf48faeb59","startFrame":722,"endFrame":814,"text":"This harvest shows up as visible works before people."},{"sceneId":"01a0cadc-f79e-729a-8129-bfaf48faeb59","startFrame":819,"endFrame":913,"text":"Ignoring either kind creates a dangerous doctrinal imbalance."},{"sceneId":"01a0cadc-f79e-7354-95cb-9e0b6787e590","startFrame":942,"endFrame":1048,"text":"The Hebrew word Tzedakah holds three inseparable meanings."},{"sceneId":"01a0cadc-f79e-7354-95cb-9e0b6787e590","startFrame":1055,"endFrame":1172,"text":"First is personal morality, which means refusing to lie or steal."},{"sceneId":"01a0cadc-f79e-7354-95cb-9e0b6787e590","startFrame":1180,"endFrame":1309,"text":"Second is justice, which means acting uprightly in business and legal dealings."},{"sceneId":"01a0cadc-f79e-7354-95cb-9e0b6787e590","startFrame":1316,"endFrame":1435,"text":"Third is charity, which means giving to the poor as a matter of justice."},{"sceneId":"01a0cadc-f79e-7354-95cb-9e0b6787e590","startFrame":1442,"endFrame":1535,"text":"Withholding help when you can give violates Tzedakah."},{"sceneId":"01a0cadc-f79e-7354-95cb-9e0b6787e590","startFrame":1540,"endFrame":1605,"text":"These three must work together in daily conduct."},{"sceneId":"01a0cadc-f79e-7dba-8053-24768f2d1aca","startFrame":1620,"endFrame":1706,"text":"Kingdom Economics puts fairness above legal rights."},{"sceneId":"01a0cadc-f79e-7dba-8053-24768f2d1aca","startFrame":1706,"endFrame":1842,"text":"If you take a poor debtor's cloak, return it before sundown."},{"sceneId":"01a0cadc-f79e-7dba-8053-24768f2d1aca","startFrame":1842,"endFrame":1953,"text":"Every seven years, debts were canceled in the Jubilee."},{"sceneId":"01a0cadc-f79e-7dba-8053-24768f2d1aca","startFrame":1953,"endFrame":2089,"text":"Landowners left gleanings at field edges for the poor and stranger."},{"sceneId":"01a0cadc-f79e-7dba-8053-24768f2d1aca","startFrame":2089,"endFrame":2187,"text":"This built a safety net directly into profit-making."},{"sceneId":"01a0cadc-f79e-7dba-8053-24768f2d1aca","startFrame":2187,"endFrame":2298,"text":"Workers must be paid promptly, not made to wait."},{"sceneId":"01a0cadc-f79e-7dba-8053-24768f2d1aca","startFrame":2298,"endFrame":2372,"text":"Never exploit someone's desperation for profit."},{"sceneId":"01a0cadc-f79e-7dba-8053-24768f2d1aca","startFrame":2372,"endFrame":2459,"text":"God judges those who oppress the afflicted."},{"sceneId":"01a0cadc-f79e-7aae-a0b7-c95171972638","startFrame":2465,"endFrame":2539,"text":"Moses had miraculous power but was burning out."},{"sceneId":"01a0cadc-f79e-7aae-a0b7-c95171972638","startFrame":2544,"endFrame":2630,"text":"Jethro taught him structural delegation to survive."},{"sceneId":"01a0cadc-f79e-7aae-a0b7-c95171972638","startFrame":2638,"endFrame":2738,"text":"Power produces the miracle, but wisdom sustains it."},{"sceneId":"01a0cadc-f79e-7aae-a0b7-c95171972638","startFrame":2746,"endFrame":2846,"text":"Jesus raised Jairus's daughter, then commanded she be fed."},{"sceneId":"01a0cadc-f79e-7aae-a0b7-c95171972638","startFrame":2851,"endFrame":2926,"text":"Without wisdom, the miracle would have been lost."},{"sceneId":"01a0cadc-f79e-7aae-a0b7-c95171972638","startFrame":2938,"endFrame":3056,"text":"Apply this to money: power earns it, wisdom keeps it."},{"sceneId":"01a0cadc-f79e-7314-8fb8-ec7b7b8fa0d7","startFrame":3060,"endFrame":3140,"text":"There are five pillars of financial stewardship."},{"sceneId":"01a0cadc-f79e-7314-8fb8-ec7b7b8fa0d7","startFrame":3140,"endFrame":3244,"text":"They are budgeting, protection, savings, investment, and debt management."},{"sceneId":"01a0cadc-f79e-7314-8fb8-ec7b7b8fa0d7","startFrame":3244,"endFrame":3336,"text":"Use the 50/30/20 rule to allocate your income."},{"sceneId":"01a0cadc-f79e-7314-8fb8-ec7b7b8fa0d7","startFrame":3336,"endFrame":3439,"text":"Fifty percent goes to needs like rent and food."},{"sceneId":"01a0cadc-f79e-7314-8fb8-ec7b7b8fa0d7","startFrame":3439,"endFrame":3531,"text":"Thirty percent goes to wants like dining out."},{"sceneId":"01a0cadc-f79e-7314-8fb8-ec7b7b8fa0d7","startFrame":3531,"endFrame":3612,"text":"Twenty percent goes to savings and investment."},{"sceneId":"01a0cadc-f79e-7314-8fb8-ec7b7b8fa0d7","startFrame":3612,"endFrame":3704,"text":"If you earn 100, 000 naira, save 20, 000 first."},{"sceneId":"01a0cadc-f79e-76a9-a2bc-1f81bf3e8af1","startFrame":3720,"endFrame":3848,"text":"The master gave talents unevenly but expected equal faithfulness."},{"sceneId":"01a0cadc-f79e-76a9-a2bc-1f81bf3e8af1","startFrame":3848,"endFrame":4019,"text":"The one-talent servant was condemned for zero growth, not for having less."},{"sceneId":"01a0cadc-f79e-76a9-a2bc-1f81bf3e8af1","startFrame":4019,"endFrame":4133,"text":"Righteousness is both a gift and a harvest."},{"sceneId":"01a0cadc-f79e-76a9-a2bc-1f81bf3e8af1","startFrame":4133,"endFrame":4218,"text":"Tzedakah demands integrity, justice, and generosity."},{"sceneId":"01a0cadc-f79e-76a9-a2bc-1f81bf3e8af1","startFrame":4218,"endFrame":4290,"text":"Kingdom Economics protects the vulnerable."},{"sceneId":"01a0cadc-f79e-76a9-a2bc-1f81bf3e8af1","startFrame":4290,"endFrame":4346,"text":"Wisdom must follow power."},{"sceneId":"01a0cadc-f79e-76a9-a2bc-1f81bf3e8af1","startFrame":4346,"endFrame":4432,"text":"Build systems across all five pillars."}],"visualAssets":[{"assetId":"01a0cae0-9426-7e70-b7ca-5400d108cf8c","altText":"generated-illustration.png","source":"source","storageKey":"users/01a0c938-7551-7405-a9e1-4db43e6bc491/projects/01a0cacc-4547-7835-b7c4-fcd924b96a92/assets/01a0cae0-9426-7e70-b7ca-5400d108cf8c/original.png","checksumSha256":"954b5e98e8e647f3b9d889bef190bfb338cabdb6f0deb73c3890155f6494f326","contentType":"image/png"},{"assetId":"01a0cae4-f700-7f19-9adb-200f31c3caeb","altText":"generated-illustration.png","source":"source","storageKey":"users/01a0c938-7551-7405-a9e1-4db43e6bc491/projects/01a0cacc-454