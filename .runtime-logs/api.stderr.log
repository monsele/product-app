55e20ead5154fdf167b7415fc07fb27c0289d5.wav","checksumSha256":"736920cd131ab907667b53ef1f70c1afcccab984578628a80b303170abb4ddd3","contentType":"audio/wav"},{"sceneId":"01a0cadc-f79e-7aae-a0b7-c95171972638","storageKey":"users/01a0c938-7551-7405-a9e1-4db43e6bc491/projects/01a0cacc-4547-7835-b7c4-fcd924b96a92/audio/01a0cadc-f79e-7aae-a0b7-c95171972638/cbbdea97897c554a714ed6184ca8e0b8e9578563ea0a5e4ccf5db22484821100.wav","checksumSha256":"227f44cf3cedac5bb53246c44749f69e6574aa5f1feb375ec8c777c891662f79","contentType":"audio/wav"},{"sceneId":"01a0cadc-f79e-7314-8fb8-ec7b7b8fa0d7","storageKey":"users/01a0c938-7551-7405-a9e1-4db43e6bc491/projects/01a0cacc-4547-7835-b7c4-fcd924b96a92/audio/01a0cadc-f79e-7314-8fb8-ec7b7b8fa0d7/1a4bd52419fcdf345a739b6629e4abb1a136e60c84e7a5de911e08a372a184a2.wav","checksumSha256":"a6b83a69e3fdbb5f906e7f0f0e1d666a03a3136b18abfc641817db1908da5f9c","contentType":"audio/wav"},{"sceneId":"01a0cadc-f79e-76a9-a2bc-1f81bf3e8af1","storageKey":"users/01a0c938-7551-7405-a9e1-4db43e6bc491/projects/01a0cacc-4547-7835-b7c4-fcd924b96a92/audio/01a0cadc-f79e-76a9-a2bc-1f81bf3e8af1/1bd38da964e844c742341f5dca85be62f630d2c07156624c9eae5fe0d2187802.wav","checksumSha256":"fdc13e9a53b2f6bb1050f2a79df826e90a5c2adbffd129d6b6bad0392f6adaca","contentType":"audio/wav"}],"captions":[{"sceneId":"01a0cadc-f79e-7747-8e44-ae7329d88b84","startFrame":0,"endFrame":148,"text":"What if one word meant righteousness, justice, and generosity at the same time?"},{"sceneId":"01a0cadc-f79e-7747-8e44-ae7329d88b84","startFrame":148,"endFrame":274,"text":"Would it change how you see your faith and your money?"},{"sceneId":"01a0cadc-f79e-7747-8e44-ae7329d88b84","startFrame":274,"endFrame":354,"text":"Let's explore the Hebrew idea of Tzedakah."},{"sceneId":"01a0cadc-f79e-729a-8129-bfaf48faeb59","startFrame":374,"endFrame":454,"text":"Every believer has two kinds of righteousness."},{"sceneId":"01a0cadc-f79e-729a-8129-bfaf48faeb59","startFrame":458,"endFrame":540,"text":"The first is a gift received by grace through faith."},{"sceneId":"01a0cadc-f79e-729a-8129-bfaf48faeb59","startFrame":545,"endFrame":622,"text":"It is a fixed legal credit that never changes."},{"sceneId":"01a0cadc-f79e-729a-8129-bfaf48faeb59","startFrame":629,"endFrame":715,"text":"The second is a harvest that can grow and multiply."},{"sceneId":"01a0cadc-f79e-729a-8129-bfaf48faeb59","startFrame":722,"endFrame":814,"text":"This harvest shows up as visible works before people."},{"sceneId":"01a0cadc-f79e-729a-8129-bfaf48faeb59","startFrame":819,"endFrame":913,"text":"Ignoring either kind creates a dangerous doctrinal imbalance."},{"sceneId":"01a0cadc-f79e-7354-95cb-9e0b6787e590","startFrame":942,"endFrame":1048,"text":"The Hebrew word Tzedakah holds three inseparable meanings."},{"sceneId":"01a0cadc-f79e-7354-95cb-9e0b6787e590","startFrame":1055,"endFrame":1172,"text":"First is personal morality, which means refusing to lie or steal."},{"sceneId":"01a0cadc-f79e-7354-95cb-9e0b6787e590","startFrame":1180,"endFrame":1309,"text":"Second is justice, which means acting uprightly in business and legal dealings."},{"sceneId":"01a0cadc-f79e-7354-95cb-9e0b6787e590","startFrame":1316,"endFrame":1435,"text":"Third is charity, which means giving to the poor as a matter of justice."},{"sceneId":"01a0cadc-f79e-7354-95cb-9e0b6787e590","startFrame":1442,"endFrame":1535,"text":"Withholding help when you can give violates Tzedakah."},{"sceneId":"01a0cadc-f79e-7354-95cb-9e0b6787e590","startFrame":1540,"endFrame":1605,"text":"These three must work together in daily conduct."},{"sceneId":"01a0cadc-f79e-7dba-8053-24768f2d1aca","startFrame":1620,"endFrame":1706,"text":"Kingdom Economics puts fairness above legal rights."},{"sceneId":"01a0cadc-f79e-7dba-8053-24768f2d1aca","startFrame":1706,"endFrame":1842,"text":"If you take a poor debtor's cloak, return it before sundown."},{"sceneId":"01a0cadc-f79e-7dba-8053-24768f2d1aca","startFrame":1842,"endFrame":1953,"text":"Every seven years, debts were canceled in the Jubilee."},{"sceneId":"01a0cadc-f79e-7dba-8053-24768f2d1aca","startFrame":1953,"endFrame":2089,"text":"Landowners left gleanings at field edges for the poor and stranger."},{"sceneId":"01a0cadc-f79e-7dba-8053-24768f2d1aca","startFrame":2089,"endFrame":2187,"text":"This built a safety net directly into profit-making."},{"sceneId":"01a0cadc-f79e-7dba-8053-24768f2d1aca","startFrame":2187,"endFrame":2298,"text":"Workers must be paid promptly, not made to wait."},{"sceneId":"01a0cadc-f79e-7dba-8053-24768f2d1aca","startFrame":2298,"endFrame":2372,"text":"Never exploit someone's desperation for profit."},{"sceneId":"01a0cadc-f79e-7dba-8053-24768f2d1aca","startFrame":2372,"endFrame":2459,"text":"God judges those who oppress the afflicted."},{"sceneId":"01a0cadc-f79e-7aae-a0b7-c95171972638","startFrame":2465,"endFrame":2539,"text":"Moses had miraculous power but was burning out."},{"sceneId":"01a0cadc-f79e-7aae-a0b7-c95171972638","startFrame":2544,"endFrame":2630,"text":"Jethro taught him structural delegation to survive."},{"sceneId":"01a0cadc-f79e-7aae-a0b7-c95171972638","startFrame":2638,"endFrame":2738,"text":"Power produces the miracle, but wisdom sustains it."},{"sceneId":"01a0cadc-f79e-7aae-a0b7-c95171972638","startFrame":2746,"endFrame":2846,"text":"Jesus raised Jairus's daughter, then commanded she be fed."},{"sceneId":"01a0cadc-f79e-7aae-a0b7-c95171972638","startFrame":2851,"endFrame":2926,"text":"Without wisdom, the miracle would have been lost."},{"sceneId":"01a0cadc-f79e-7aae-a0b7-c95171972638","startFrame":2938,"endFrame":3056,"text":"Apply this to money: power earns it, wisdom keeps it."},{"sceneId":"01a0cadc-f79e-7314-8fb8-ec7b7b8fa0d7","startFrame":3060,"endFrame":3140,"text":"There are five pillars of financial stewardship."},{"sceneId":"01a0cadc-f79e-7314-8fb8-ec7b7b8fa0d7","startFrame":3140,"endFrame":3244,"text":"They are budgeting, protection, savings, investment, and debt management."},{"sceneId":"01a0cadc-f79e-7314-8fb8-ec7b7b8fa0d7","startFrame":3244,"endFrame":3336,"text":"Use the 50/30/20 rule to allocate your income."},{"sceneId":"01a0cadc-f79e-7314-8fb8-ec7b7b8fa0d7","startFrame":3336,"endFrame":3439,"text":"Fifty percent goes to needs like rent and food."},{"sceneId":"01a0cadc-f79e-7314-8fb8-ec7b7b8fa0d7","startFrame":3439,"endFrame":3531,"text":"Thirty percent goes to wants like dining out."},{"sceneId":"01a0cadc-f79e-7314-8fb8-ec7b7b8fa0d7","startFrame":3531,"endFrame":3612,"text":"Twenty percent goes to savings and investment."},{"sceneId":"01a0cadc-f79e-7314-8fb8-ec7b7b8fa0d7","startFrame":3612,"endFrame":3704,"text":"If you earn 100, 000 naira, save 20, 000 first."},{"sceneId":"01a0cadc-f79e-76a9-a2bc-1f81bf3e8af1","startFrame":3720,"endFrame":3848,"text":"The master gave talents unevenly but expected equal faithfulness."},{"sceneId":"01a0cadc-f79e-76a9-a2bc-1f81bf3e8af1","startFrame":3848,"endFrame":4019,"text":"The one-talent servant was condemned for zero growth, not for having less."},{"sceneId":"01a0cadc-f79e-76a9-a2bc-1f81bf3e8af1","startFrame":4019,"endFrame":4133,"text":"Righteousness is both a gift and a harvest."},{"sceneId":"01a0cadc-f79e-76a9-a2bc-1f81bf3e8af1","startFrame":4133,"endFrame":4218,"text":"Tzedakah demands integrity, justice, and generosity."},{"sceneId":"01a0cadc-f79e-76a9-a2bc-1f81bf3e8af1","startFrame":4218,"endFrame":4290,"text":"Kingdom Economics protects the vulnerable."},{"sceneId":"01a0cadc-f79e-76a9-a2bc-1f81bf3e8af1","startFrame":4290,"endFrame":4346,"text":"Wisdom must follow power."},{"sceneId":"01a0cadc-f79e-76a9-a2bc-1f81bf3e8af1","startFrame":4346,"endFrame":4432,"text":"Build systems across all five pillars."}],"visualAssets":[{"assetId":"01a0cae0-9426-7e70-b7ca-5400d108cf8c","altText":"generated-illustration.png","source":"source","storageKey":"users/01a0c938-7551-7405-a9e1-4db43e6bc491/projects/01a0cacc-4547-7835-b7c4-fcd924b96a92/assets/01a0cae0-9426-7e70-b7ca-5400d108cf8c/original.png","checksumSha256":"954b5e98e8e647f3b9d889bef190bfb338cabdb6f0deb73c3890155f6494f326","contentType":"image/png"},{"assetId":"01a0cae4-f700-7f19-9adb-200f31c3caeb","altText":"generated-illustration.png","source":"source","storageKey":"users/01a0c938-7551-7405-a9e1-4db43e6bc491/projects/01a0cacc-4547-7835-b7c4-fcd924b96a92/assets/01a0cae4-f700-7f19-9adb-200f31c3caeb/original.png","checksumSha256":"862c012dd07ca1cfddef1ed7b5fadd2a89e5e3d1f2377a25e43308ad761c1455","contentType":"image/png"},{"assetId":"01a0cae4-cf10-78b7-8a79-e25f2dde797e","altText":"generated-illustration.png","source":"source","storageKey":"users/01a0c938-7551-7405-a9e1-4db43e6bc491/projects/01a0cacc-4547-7835-b7c4-fcd924b96a92/assets/01a0cae4-cf10-78b7-8a79-e25f2dde797e/original.png","checksumSha256":"0d57527d67f1b0428e85803731f80a3622a8bbc0565b128c3cba7f3d7e2ab474","contentType":"image/png"},{"assetId":"01a0cae0-b4b7-7c4b-b8c0-d6037f2b7ae2","altText":"generated-illustration.png","source":"source","storageKey":"users/01a0c938-7551-7405-a9e1-4db43e6bc491/projects/01a0cacc-4547-7835-b7c4-fcd924b96a92/assets/01a0cae0-b4b7-7c4b-b8c0-d6037f2b7ae2/original.png","checksumSha256":"6821c17f6f95b108a506c490d3227f4bebef70276c4633b51ac3349afeeb59c1","contentType":"image/png"},{"assetId":"01a0cae0-7228-716c-a380-c8c38e3d4fd0","altText":"generated-illustration.png","source":"source","storageKey":"users/01a0c938-7551-7405-a9e1-4db43e6bc491/projects/01a0cacc-4547-7835-b7c4-fcd924b96a92/assets/01a0cae0-7228-716c-a380-c8c38e3d4fd0/original.png","checksumSha256":"e17869ac541d231422f81bfa8892e5c35a090091e4e0261b0ab130b51e08e570","contentType":"image/png"},{"assetId":"01a0cae0-4e1c-78aa-8b7a-73a06b5ed4ed","altText":"generated-illustration.png","source":"source","storageKey":"users/01a0c938-7551-7405-a9e1-4db43e6bc491/projects/01a0cacc-4547-7835-b7c4-fcd924b96a92/assets/01a0cae0-4e1c-78aa-8b7a-73a06b5ed4ed/original.png","checksumSha256":"249b97e86d7ab0f5af8c2e6e8d483825e4334c0e84d210f267f4e3e4143faa79","contentType":"image/png"},{"assetId":"01a0cae0-2872-7ad1-8d13-b55b6e7ed106","altText":"generated-illustration.png","source":"source","storageKey":"users/01a0c938-7551-7405-a9e1-4db43e6bc491/projects/01a0cacc-4547-7835-b7c4-fcd924b96a92/assets/01a0cae0-2872-7ad1-8d13-b55b6e7ed106/original.png","checksumSha256":"9dd9c9dc7633b29ef9c32d5ba9bd00d8c4ce8b40ebf96310c2b8330592063754","contentType":"image/png"},{"assetId":"01a0cae0-03bf-7a65-8f7e-51267476fdd0","altText":"generated-illustration.png","source":"source","storageKey":"users/01a0c938-7551-7405-a9e1-4db43e6bc491/projects/01a0cacc-4547-7835-b7c4-fcd924b96a92/assets/01a0cae0-03bf-7a65-8f7e-51267476fdd0/original.png","checksumSha256":"cb6227451dc2753018c2259c7cf58bfd6c2f9fd74738ef65fdad6f0a1f367a37","contentType":"image/png"},{"assetId":"01a0cadf-d363-725e-8931-78ad3bb235cf","altText":"generated-illustration.png","source":"source","storageKey":"users/01a0c938-7551-7405-a9e1-4db43e6bc491/projects/01a0cacc-4547-7835-b7c4-fcd924b96a92/assets/01a0cadf-d363-725e-8931-78ad3bb235cf/original.png","checksumSha256":"6b6d3f8ec5c7d882ca12dd830f325981b1296d1a038fbad66187eaba997b5a01","contentType":"image/png"},{"assetId":"01a0cae0-d61b-7b3e-9ce8-017ad7eb2831","altText":"generated-illustration.png","source":"source","storageKey":"users/01a0c938-7551-7405-a9e1-4db43e6bc491/projects/01a0cacc-4547-7835-b7c4-fcd924b96a92/assets/01a0cae0-d61b-7b3e-9ce8-017ad7eb2831/original.png","checksumSha256":"0393d53777d7ff25f6c7e7dda1ffcb853be2a0cc1e99bbd4d8671f52912bec9f","contentType":"image/png"},{"assetId":"211b6fd2-19e2-7eef-bf16-b89db79c6a67","altText":"Table: Column 1, Column 2, Column 3","source":"source_table","table":{"tableId":"211b6fd2-19e2-7eef-bf16-b89db79c6a67","columns":["Column 1","Column 2","Column 3"],"rows":[["Pillar","Diagnostic Evaluation Questions Spiritual / Practical Action Step",""],["Do I have a written plan for every income before it arrives? Am I tracking small daily leaks?","Implement the 50/30/20 Rule using a physical ledger or digital tracking app. Check bank statements monthly.","1. Budgeting"],["Would a medical emergency or auto accident bankrupt me? Do I have an emergency fund?","Obtain a basic health insurance policy. Set aside a portion of income until 3-6 months of expenses are saved.","2. Protection"],["Am I squandering 100% of my income? Am I prepared for seasonal drops or dry seasons?","Automate a 10% to 20% savings sweep from your salary. Cultivate the wisdom of the ant (Proverbs 6:6-8).","3. Savings"],["Am I leaving my savings to deplete in standard accounts? Am I chasing high-yield scams?","Decline 'get-rich-quick' schemes. Commit to reading one book on financial markets before investing in assets.","4. Investment"],["Am I borrowing to fund my lifestyle? If I am currently in debt, do I have a proactive plan?","Eradicate consumer debt. If currently in debt, write down a repayment plan and send monthly updates to the lender.","5. Debt"]],"rowCount":6,"truncated":false}}],"profile":{"width":1920,"height":1080,"fps":30,"videoCodec":"h264","audioCodec":"aac","pixelFormat":"yuv420p"},"snapshot":{"outline":{"set":{"id":"01a0cad5-389d-7228-9f90-d037d4f13282","model":"moonshotai/Kimi-K3","status":"approved","promptId":"outline","revision":0,"createdAt":"2026-09-22T20:36:06.429Z","projectId":"01a0cacc-4547-7835-b7c4-fcd924b96a92","updatedAt":"2026-09-22T20:39:16.256Z","generatedAt":"2026-09-22T20:36:06.429Z","modelCallId":"01a0cad5-389d-7172-a69e-b9246e566ec8","ownerUserId":"01a0c938-7551-7405-a9e1-4db43e6bc491","promptVersion":"v2","idempotencyKey":"outline.generate:01a0cacc-4547-7835-b7c4-fcd924b96a92:outline:01a0cacd-ada1-7d9c-b0a0-a25de9158d02:9c4bbd04d94cf9242ae2fa11ad3e8f7172f9445b507c65be9e9c2eef9128f09a:v2:43c229363c35eb5b8620fc198bbe1cd4134e96fbc14174ebb33e7b85844d065d:4cd6bedfbab5702e443edb6cbf2ad699eecbdb282b435d14bc3f97d5bde7734b","objectiveSetId":"01a0cace-ecd7-7668-ac5b-3ad7214dee32","sourceSnapshotId":"01a0cacd-ada1-7d9c-b0a0-a25de9158d02","configurationVersion":1,"totalEstimatedSeconds":180,"objectiveSetContentHash":"b35804b7cc3460fb2c9d742823b62576cceeeeca15054d19282540ba4072fd9c","sourceSnapshotContentHash":"9c4bbd04d94cf9242ae2fa11ad3e8f7172f9445b507c65be9e9c2eef9128f09a"},"items":[{"id":"01a0cad5-389d-7339-abcd-a088304761fe","kind":"hook","order":1,"setId":"01a0cad5-389d-7228-9f90-d037d4f13282","title":"Two Very Different Words for One Idea","revision":0,"createdAt":"2026-09-22T20:36:06.429Z","generated":true,"projectId":"01a0cacc-4547-7835-b7c4-fcd924b96a92","updatedAt":"2026-09-22T20:36:06.429Z","sourceRefs":[],"description":"Pose a thought-provoking question to spark curiosity: imagine someone tells you that righteousness, justice, and generosity are all the same word in Hebrew. How would that change the way you think about your faith and your money? This opening sets the stage for exploring Tzedakah and the twin manifestations of righteousness that will unfold throughout the lesson.","framingNote":"This is a generated framing device designed to introduce the theme of righteousness as both a gift and a practical harvest, and to prime learners for the Hebrew concept of Tzedakah.","ownerUserId":"01a0c938-7551-7405-a9e1-4db43e6bc491","estimatedSeconds":20},{"id":"01a0cad5-389d-7031-b76d-c995eeabc236","kind":"concept","order":2,"setId":"01a0cad5-389d-7228-9f90-d037d4f13282","title":"Two Manifestations of Righteousness","revision":0,"createdAt":"2026-09-22T20:36:06.429Z","generated":true,"projectId":"01a0cacc-4547-7835-b7c4-fcd924b96a92","updatedAt":"2026-09-22T20:36:06.429Z","sourceRefs":[{"pageEnd":3,"blockIds":["7af22950-46db-75ef-a410-7afe128a90aa","c963b0b0-1108-7ea7-940d-01123d9cc020","d0c0e6db-3dc0-7132-80b1-b30a86bfb826"],"pageStart":3,"sectionId":"ae281305-b489-7168-892d-1b43eb1f6932","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}],"description":"Teach the core distinction between righteousness as a gift (positional, received by grace through faith, fixed and unchangeable) and the harvest of righteousness (practical, dynamic, multiplied through visible works). Explain why both must be visible and active in a believer's life, and warn against the dangerous doctrinal imbalance of neglecting either one.","framingNote":null,"ownerUserId":"01a0c938-7551-7405-a9e1-4db43e6bc491","estimatedSeconds":30},{"id":"01a0cad5-389d-7d10-b38f-40c5147cf02e","kind":"concept","order":3,"setId":"01a0cad5-389d-7228-9f90-d037d4f13282","title":"Tzedakah: Three Ramifications of One Hebrew Word","revision":0,"createdAt":"2026-09-22T20:36:06.429Z","generated":true,"projectId":"01a0cacc-4547-7835-b7c4-fcd924b96a92","updatedAt":"2026-09-22T20:36:06.429Z","sourceRefs":[{"pageEnd":5,"blockIds":["06034497-9561-73ab-9a48-7e0b4dd07526","49c29e8f-988b-7974-8e1c-98507766b8dc","74a62c36-c225-74cd-ab8b-4c70bfa21c0c","fe3027da-43fa-7c54-abee-645434318ebe"],"pageStart":5,"sectionId":"b8b1cd0e-0c38-7a4c-b81c-f5b63a2e5bba","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}],"description":"Introduce the Hebrew word Tzedakah and unpack its three inseparable ramifications: personal morality (internal rectitude, refusing to lie or steal), justice (structural uprightness in societal, legal, and business dealings), and charity/generosity (giving to the poor as a matter of justice, not optional benevolence). Show how each ramification applies directly to daily conduct.","framingNote":null,"ownerUserId":"01a0c938-7551-7405-a9e1-4db43e6bc491","estimatedSeconds":30},{"id":"01a0cad5-389d-79f7-a307-8ebae0b2113d","kind":"example","order":4,"setId":"01a0cad5-389d-7228-9f90-d037d4f13282","title":"Kingdom Economics in Action","revision":0,"createdAt":"2026-09-22T20:36:06.429Z","generated":true,"projectId":"01a0cacc-4547-7835-b7c4-fcd924b96a92","updatedAt":"2026-09-22T20:36:06.429Z","sourceRefs":[{"pageEnd":5,"blockIds":["23d224bd-1662-7e5a-93b1-c26aa4216531","9192540a-67d8-7cd6-8b2a-7c756cd244d9","a8294542-be65-7173-89e6-421f1913a466","b29eff38-6707-7ec8-9cc2-3acf8b734309","b2b17cf5-d046-7435-b026-b9e3ddb02152","f1f0308a-70b9-7c61-bf74-93a6bf2ad067"],"pageStart":5,"sectionId":"0b36c7d7-5424-7634-928c-baea7fb3aa2b","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}],"description":"Walk through several concrete Kingdom Economics practices drawn from Biblical law: returning a poor debtor's cloak before sundown (fairness over legal rights), periodic debt cancellation every seven years (the Jubilee), leaving gleanings at the edges of fields for the poor and the stranger, prompt payment of workers, and refusing to exploit someone's desperation for profit. For each practice, explain how it builds protection for the vulnerable directly into economic life.","framingNote":null,"ownerUserId":"01a0c938-7551-7405-a9e1-4db43e6bc491","estimatedSeconds":35},{"id":"01a0cad5-389d-75ce-82bf-327126d5055b","kind":"analogy","order":5,"setId":"01a0cad5-389d-7228-9f90-d037d4f13282","title":"Power Produces the Miracle; Wisdom Sustains It","revision":0,"createdAt":"2026-09-22T20:36:06.429Z","generated":true,"projectId":"01a0cacc-4547-7835-b7c4-fcd924b96a92","updatedAt":"2026-09-22T20:36:06.429Z","sourceRefs":[{"pageEnd":7,"blockIds":["44fdb66c-c888-7231-9e57-293f33c4efea","afe140a5-8141-7709-8e11-8dfb41acef12"],"pageStart":7,"sectionId":"1ec7b67c-4e37-70cc-8c39-afaab46897f4","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325},{"pageEnd":7,"blockIds":["2f2a6065-ab09-75d0-b83d-f382b614cf54"],"pageStart":7,"sectionId":"27a1c852-016a-7f51-86c4-bea4e36155a1","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}],"description":"Use the Jethro narrative (Exodus 18) and the Mark 5 resurrection account to illustrate the critical difference between the power of God and the wisdom of God. Moses had miraculous power but was burning out until Jethro taught him structural delegation. Jesus raised Jairus's daughter by supernatural power but immediately commanded that she be given food—practical wisdom to sustain what power had produced. Predict what happens when wisdom does not follow power: burnout, loss, and destruction of what was built.","framingNote":null,"ownerUserId":"01a0c938-7551-7405-a9e1-4db43e6bc491","estimatedSeconds":25},{"id":"01a0cad5-389d-76cd-a462-3d9526f9f602","kind":"concept","order":6,"setId":"01a0cad5-389d-7228-9f90-d037d4f13282","title":"Five Pillars of Financial Stewardship and the 50/30/20 Rule","revision":0,"createdAt":"2026-09-22T20:36:06.429Z","generated":true,"projectId":"01a0cacc-4547-7835-b7c4-fcd924b96a92","updatedAt":"2026-09-22T20:36:06.429Z","sourceRefs":[{"pageEnd":9,"blockIds":["f95b27d2-c234-738f-87ee-cf404117fd5a"],"pageStart":9,"sectionId":"05d93e71-77f1-79af-903f-44645f4eca12","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325},{"pageEnd":9,"blockIds":["d8d10398-fc31-7207-8067-7d205b09e480","dd8e865f-a031-7bdc-8f60-67cddffe293f"],"pageStart":9,"sectionId":"b9aeaa29-20f7-7aed-9afc-8d6e97474ef2","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325},{"pageEnd":9,"blockIds":["19c878fa-239b-717b-b639-679449af7ad3"],"pageStart":9,"sectionId":"f9ed18f5-bfbf-78af-a209-208907dfac30","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325},{"pageEnd":9,"blockIds":["7a32b18c-fe32-715f-b6f2-3ef07a0836cf"],"pageStart":9,"sectionId":"9a6de675-995a-7740-ab5b-26f425655e0a","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325},{"pageEnd":11,"blockIds":["66e311a8-add0-7a1d-8ef6-093444c88a60"],"pageStart":11,"sectionId":"db102ffa-82bb-745f-be36-1708b4b455c4","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325},{"pageEnd":11,"blockIds":["09df5ee4-b668-7289-9457-76279f00717b"],"pageStart":11,"sectionId":"5d29fd16-f27e-7798-bd4a-a3c77b40545d","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}],"description":"Present the five pillars of financial stewardship: budgeting and tracking, protection (insurance and emergency funds), savings, investment, and debt management. Then demonstrate the 50/30/20 allocation rule—50% for needs, 30% for wants, 20% for savings and investment—and walk through a sample budget calculation so learners can see how to apply the formula to a real income figure.","framingNote":null,"ownerUserId":"01a0c938-7551-7405-a9e1-4db43e6bc491","estimatedSeconds":25},{"id":"01a0cad5-389d-7ecb-b92c-ab7e26018321","kind":"summary","order":7,"setId":"01a0cad5-389d-7228-9f90-d037d4f13282","title":"Faithfulness Is the Standard, Not the Amount","revision":0,"createdAt":"2026-09-22T20:36:06.429Z","generated":true,"projectId":"01a0cacc-4547-7835-b7c4-fcd924b96a92","updatedAt":"2026-09-22T20:36:06.429Z","sourceRefs":[{"pageEnd":7,"blockIds":["49ec6ab8-4041-757d-8594-ceb5170b4b8e"],"pageStart":7,"sectionId":"62712383-7b98-77d3-875f-babdb7c3ef46","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}],"description":"Close by drawing together the Parable of the Talents (Matthew 25) with the lesson's major threads. Compare the outcomes of the servants: the five-talent and two-talent servants grew what they were given, while the one-talent servant was condemned not because he had less, but because he showed zero growth and made no interest. Summarize the key takeaways: righteousness is both a gift and a harvest, Tzedakah demands moral integrity, justice, and generosity, Kingdom Economics protects the vulnerable, wisdom must follow power, and faithful stewardship requires deliberate systems across all five pillars.","framingNote":null,"ownerUserId":"01a0c938-7551-7405-a9e1-4db43e6bc491","estimatedSeconds":15}]},"versions":{"prompts":{"narration":"v3","storyboard":"v2"},"lessonSpec":"1.8","sceneLibrary":"mvp-v1","creativeDesign":"mvp-default"},"citations":{"createdAt":"2026-09-22T22:39:35.067Z","lessonSpecId":"01a0cadc-f79e-798c-8f27-169a3d5b7505","schemaVersion":"citation-history-v1","sceneCitations":[{"sceneId":"01a0cadc-f79e-7747-8e44-ae7329d88b84","citations":[{"blocks":[{"kind":"paragraph","page":5,"text":"To fully grasp the Biblical framework of righteousness, one must look past the language barrier and explore the original  Hebrew  word Tzedakah (spelled:  T-Z-E-D-A-K-A-H).  While  English  translations  often  split  this  into distinct concepts of morality, justice, or charity, the Hebrew mind understood them as inseparable parts of a single whole. Tzedakah has three critical ramifications:","blockId":"06034497-9561-73ab-9a48-7e0b4dd07526","sectionId":"b8b1cd0e-0c38-7a4c-b81c-f5b63a2e5bba"}],"issues":[],"tables":[],"figures":[],"pageEnd":5,"pageStart":5,"sectionId":"b8b1cd0e-0c38-7a4c-b81c-f5b63a2e5bba","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","sectionHeading":"THE HEBREW WORD 'TZEDAKAH' & ITS RAMIFICATIONS","parsedDocumentVersion":94508325}],"generatedAdditions":[]},{"sceneId":"01a0cadc-f79e-729a-8129-bfaf48faeb59","citations":[{"blocks":[{"kind":"paragraph","page":3,"text":"1. Righteousness as a Gift (Positional Righteousness): This is the legal foundation of our salvation. It is received entirely by grace through faith, apart from human works. As stated in Galatians 3:6 and Romans 4, 'Abraham believed God, and it was accounted to him for righteousness.' This is a fixed, perfect legal credit on the  believer's  account  that  cannot  be  added  to,  multiplied,  or  diminished.  It  is  a  gift  that  establishes  one's permanent relationship and covenant standing with God.","blockId":"7af22950-46db-75ef-a410-7afe128a90aa","sectionId":"ae281305-b489-7168-892d-1b43eb1f6932"},{"kind":"paragraph","page":3,"text":"A central theme of the teaching is that there are two distinct manifestations of righteousness in the life of every  believer,  and  both  must  be  visible  and  active.  Understanding  the  distinction  is  the  key  to  avoiding  a dangerous doctrinal imbalance.","blockId":"c963b0b0-1108-7ea7-940d-01123d9cc020","sectionId":"ae281305-b489-7168-892d-1b43eb1f6932"},{"kind":"paragraph","page":3,"text":"2.  The  Harvest  of  Righteousness  (Practical  Righteousness): Based  on  2  Corinthians  9:10  ( 'He  who supplies seed to the sower and bread for food will supply and multiply your seed for sowing and increase the harvest of your righteousness' ), this manifestation is dynamic and agricultural. While the gift of righteousness cannot  increase,  the  harvest  of  righteousness  can  and  should  be  multiplied.  This  represents  the  visible demonstrations, fruits, and works of righteousness before men. As the preacher emphasized, 'It  is  true  that righteousness is not by works, but you cannot separate works from righteousness.' Works do not qualify us before God, but they demonstrate our faith before people.","blockId":"d0c0e6db-3dc0-7132-80b1-b30a86bfb826","sectionId":"ae281305-b489-7168-892d-1b43eb1f6932"}],"issues":[],"tables":[],"figures":[],"pageEnd":3,"pageStart":3,"sectionId":"ae281305-b489-7168-892d-1b43eb1f6932","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","sectionHeading":"THE TWO MANIFESTATIONS OF RIGHTEOUSNESS","parsedDocumentVersion":94508325}],"generatedAdditions":[]},{"sceneId":"01a0cadc-f79e-7354-95cb-9e0b6787e590","citations":[{"blocks":[{"kind":"paragraph","page":5,"text":"To fully grasp the Biblical framework of righteousness, one must look past the language barrier and explore the original  Hebrew  word Tzedakah (spelled:  T-Z-E-D-A-K-A-H).  While  English  translations  often  split  this  into distinct concepts of morality, justice, or charity, the Hebrew mind understood them as inseparable parts of a single whole. Tzedakah has three critical ramifications:","blockId":"06034497-9561-73ab-9a48-7e0b4dd07526","sectionId":"b8b1cd0e-0c38-7a4c-b81c-f5b63a2e5bba"},{"kind":"paragraph","page":5,"text":"3.  Charity  and  Generosity: In  the  Hebrew  scriptures,  giving  to  the  poor  is  not  categorized  as  'optional benevolence'; it is classified as a matter of justice and righteousness . To withhold help from the poor when you have the power to give is to violate Tzedakah .","blockId":"49c29e8f-988b-7974-8e1c-98507766b8dc","sectionId":"b8b1cd0e-0c38-7a4c-b81c-f5b63a2e5bba"},{"kind":"paragraph","page":5,"text":"1. Personal Morality: This is the internal rectitude of the believer-standing clean before God, refusing to lie, steal, or compromise one's moral character.","blockId":"74a62c36-c225-74cd-ab8b-4c70bfa21c0c","sectionId":"b8b1cd0e-0c38-7a4c-b81c-f5b63a2e5bba"},{"kind":"paragraph","page":5,"text":"2. Justice: This is the structural expression of righteousness-refusing to oppress the vulnerable, standing up against unfairness, and acting uprightly in all societal, legal, and business transactions.","blockId":"fe3027da-43fa-7c54-abee-645434318ebe","sectionId":"b8b1cd0e-0c38-7a4c-b81c-f5b63a2e5bba"}],"issues":[],"tables":[],"figures":[],"pageEnd":5,"pageStart":5,"sectionId":"b8b1cd0e-0c38-7a4c-b81c-f5b63a2e5bba","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","sectionHeading":"THE HEBREW WORD 'TZEDAKAH' & ITS RAMIFICATIONS","parsedDocumentVersion":94508325}],"generatedAdditions":[]},{"sceneId":"01a0cadc-f79e-7dba-8053-24768f2d1aca","citations":[{"blocks":[{"kind":"list","page":5,"text":"Fairness Over Legal Rights (Deuteronomy 24:10-13): Biblical law dictates that if you take a poor debtor's cloak  as  collateral,  you  must  return  it  to  him  before  sundown  so  he  can  sleep.  Legal  right  must  never supersede basic humanity and fairness.","blockId":"23d224bd-1662-7e5a-93b1-c26aa4216531","sectionId":"0b36c7d7-5424-7634-928c-baea7fb3aa2b"},{"kind":"list","page":5,"text":"Prompt Payment of Workers (Jeremiah 22:13, James 5:4): Withholding wages or paying employees late is  a  severe  violation  of  righteousness.  The  scripture  issues  a  woe  to  those  who  build  their  houses  by unrighteousness and use their neighbor's service without wages.","blockId":"9192540a-67d8-7cd6-8b2a-7c756cd244d9","sectionId":"0b36c7d7-5424-7634-928c-baea7fb3aa2b"},{"kind":"list","page":5,"text":"Leaving Gleanings for the Poor: Business owners in Israel were commanded not to harvest their fields to the  very  edges,  but  to  leave  the  corners  and  unharvested  produce  for  the  poor,  the  widow,  and  the stranger.  This  is  a  Biblical  business  model  that  builds  a  social  safety  net  directly  into  profit-generating activities.","blockId":"a8294542-be65-7173-89e6-421f1913a466","sectionId":"0b36c7d7-5424-7634-928c-baea7fb3aa2b"},{"kind":"paragraph","page":5,"text":"Kingdom Economics operates on laws that directly contradict the ruthless, self-serving capitalistic models of the world. Believers are called to implement these ancient structural consecrations in their business dealings and personal finances:","blockId":"b29eff38-6707-7ec8-9cc2-3acf8b734309","sectionId":"0b36c7d7-5424-7634-928c-baea7fb3aa2b"},{"kind":"list","page":5,"text":"Refusing  to  Exploit  Bargaining  Power: Believers  must  never  monetize  another  person's  desperation (e.g., buying an asset at a ridiculously low price because the owner is facing an emergency). Oppressing the afflicted or robbing the poor prompts the Lord to step in as a judge to plead their cause and plunder the soul of the plunderers (Proverbs 22:22-23).","blockId":"b2b17cf5-d046-7435-b026-b9e3ddb02152","sectionId":"0b36c7d7-5424-7634-928c-baea7fb3aa2b"},{"kind":"list","page":5,"text":"Periodic  Debt  Cancellation  (The  Jubilee): The  Old  Testament  instituted  a  cycle  where  debts  were canceled every seven years. God warned that lenders must not refuse to help a borrower on the sixth year simply because the year of cancellation was near.","blockId":"f1f0308a-70b9-7c61-bf74-93a6bf2ad067","sectionId":"0b36c7d7-5424-7634-928c-baea7fb3aa2b"}],"issues":[],"tables":[],"figures":[],"pageEnd":5,"pageStart":5,"sectionId":"0b36c7d7-5424-7634-928c-baea7fb3aa2b","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","sectionHeading":"THE SYSTEM OF KINGDOM ECONOMICS","parsedDocumentVersion":94508325}],"generatedAdditions":[]},{"sceneId":"01a0cadc-f79e-7aae-a0b7-c95171972638","citations":[{"blocks":[{"kind":"paragraph","page":7,"text":"Jethro advised Moses to institute structural delegation and systems. This narrative establishes a major spiritual paradigm: the power of God is distinct from the wisdom of God , yet both are necessary. A person can have the power of God in raw, visible form, but without the wisdom of God to organize and structure their life, they will burn out and destroy what has been built. Power produces the miracle; wisdom sustains it.","blockId":"44fdb66c-c888-7231-9e57-293f33c4efea","sectionId":"1ec7b67c-4e37-70cc-8c39-afaab46897f4"},{"kind":"paragraph","page":7,"text":"The sermon begins with an illuminating  look  at Exodus 18:14-20 .  Moses,  having  performed  mind-boggling miracles-including  parting  the  Red  Sea  and  bringing  plagues  upon  Egypt-was  sitting  from  morning  until evening  judging  the  disputes  of  all  Israel.  His  father-in-law,  Jethro,  observed  this  and  delivered  a  startling critique: 'The thing that you do is not good. Both you and these people... will surely wear yourselves out, for this thing is too much for you.'","blockId":"afe140a5-8141-7709-8e11-8dfb41acef12","sectionId":"1ec7b67c-4e37-70cc-8c39-afaab46897f4"}],"issues":[],"tables":[],"figures":[],"pageEnd":7,"pageStart":7,"sectionId":"1ec7b67c-4e37-70cc-8c39-afaab46897f4","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","sectionHeading":"THE PRINCIPLE OF JETHRO: POWER VS. WISDOM","parsedDocumentVersion":94508325},{"blocks":[{"kind":"paragraph","page":7,"text":"In  Mark  5:41-43,  after  Jesus  raised  Jairus's  daughter  from  the  dead-an  undeniable  demonstration  of creative,  supernatural  power-He  immediately  commanded  that 'something  should  be  given  her  to  eat.' Jesus recognized that while the power of God brought her back to life, the practical wisdom of nourishment was  required  to  keep  her  alive.  Without  wisdom  following  power,  she  would  have  died  again.  Similarly, believers must apply practical financial wisdom to sustain the financial blessings God brings their way.","blockId":"2f2a6065-ab09-75d0-b83d-f382b614cf54","sectionId":"27a1c852-016a-7f51-86c4-bea4e36155a1"}],"issues":[],"tables":[],"figures":[],"pageEnd":7,"pageStart":7,"sectionId":"27a1c852-016a-7f51-86c4-bea4e36155a1","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","sectionHeading":"THE RESURRECTION PROTOCOL: MARK 5","parsedDocumentVersion":94508325}],"generatedAdditions":[]},{"sceneId":"01a0cadc-f79e-7314-8fb8-ec7b7b8fa0d7","citations":[{"blocks":[{"kind":"paragraph","page":9,"text":"The  teaching  structures  personal  finance  into  five  practical  pillars.  To  be  a  faithful  steward,  one  must systematically build and implement systems across each of these categories:","blockId":"f95b27d2-c234-738f-87ee-cf404117fd5a","sectionId":"05d93e71-77f1-79af-903f-44645f4eca12"}],"issues":[],"tables":[],"figures":[],"pageEnd":9,"pageStart":9,"sectionId":"05d93e71-77f1-79af-903f-44645f4eca12","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","sectionHeading":"The Operational Framework for Financial Faithfulness","parsedDocumentVersion":94508325},{"blocks":[{"kind":"paragraph","page":9,"text":"THE 50/30/20 BUDGET FORMULA The 50/30/20 Allocation Rule: A highly practical formula for financial discipline: · 50%  Needs: Non-negotiable  survival  costs:  Rent,  basic  feeding,  essential  transportation,  internet,  and protection. · 30% Wants: Desires that you can live without: Fine dining, fast food (shawarma/pizza), and luxury items. · 20% Savings & Investment: Funds reserved for future growth. As income grows, the percentage allocated to savings and investment must increase.","blockId":"dd8e865f-a031-7bdc-8f60-67cddffe293f","sectionId":"b9aeaa29-20f7-7aed-9afc-8d6e97474ef2"}],"issues":[],"tables":[],"figures":[],"pageEnd":9,"pageStart":9,"sectionId":"b9aeaa29-20f7-7aed-9afc-8d6e97474ef2","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","sectionHeading":"PILLAR 1: BUDGETING & TRACKING","parsedDocumentVersion":94508325}],"generatedAdditions":[]},{"sceneId":"01a0cadc-f79e-76a9-a2bc-1f81bf3e8af1","citations":[{"blocks":[{"kind":"paragraph","page":7,"text":"Truth 2: God Demands Accountability: In  the  Parable of the Talents (Matthew 25), the master distributed resources unequally-giving five talents, two talents, and one talent based on individual ability. However, the master expected the exact same standard of faithfulness  and  interest from  everyone.  The  servant  with  one talent was not condemned because he made less than the five-talent servant; he was condemned as a 'wicked and  lazy  servant' because  he  made no interest and  showed  zero  growth.  Your  current  financial  level  is  a stewardship test: if you cannot manage 200,000 naira, receiving 20 million will not solve your problems-it will only enable you to make more expensive mistakes.","blockId":"49ec6ab8-4041-757d-8594-ceb5170b4b8e","sectionId":"62712383-7b98-77d3-875f-babdb7c3ef46"}],"issues":[],"tables":[],"figures":[],"pageEnd":7,"pageStart":7,"sectionId":"62712383-7b98-77d3-875f-babdb7c3ef46","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","sectionHeading":"FINANCIAL STEWARDSHIP: TWO CORE TRUTHS","parsedDocumentVersion":94508325},{"blocks":[{"kind":"paragraph","page":5,"text":"To fully grasp the Biblical framework of righteousness, one must look past the language barrier and explore the original  Hebrew  word Tzedakah (spelled:  T-Z-E-D-A-K-A-H).  While  English  translations  often  split  this  into distinct concepts of morality, justice, or charity, the Hebrew mind understood them as inseparable parts of a single whole. Tzedakah has three critical ramifications:","blockId":"06034497-9561-73ab-9a48-7e0b4dd07526","sectionId":"b8b1cd0e-0c38-7a4c-b81c-f5b63a2e5bba"}],"issues":[],"tables":[],"figures":[],"pageEnd":5,"pageStart":5,"sectionId":"b8b1cd0e-0c38-7a4c-b81c-f5b63a2e5bba","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","sectionHeading":"THE HEBREW WORD 'TZEDAKAH' & ITS RAMIFICATIONS","parsedDocumentVersion":94508325},{"blocks":[{"kind":"paragraph","page":7,"text":"Jethro advised Moses to institute structural delegation and systems. This narrative establishes a major spiritual paradigm: the power of God is distinct from the wisdom of God , yet both are necessary. A person can have the power of God in raw, visible form, but without the wisdom of God to organize and structure their life, they will burn out and destroy what has been built. Power produces the miracle; wisdom sustains it.","blockId":"44fdb66c-c888-7231-9e57-293f33c4efea","sectionId":"1ec7b67c-4e37-70cc-8c39-afaab46897f4"}],"issues":[],"tables":[],"figures":[],"pageEnd":7,"pageStart":7,"sectionId":"1ec7b67c-4e37-70cc-8c39-afaab46897f4","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","sectionHeading":"THE PRINCIPLE OF JETHRO: POWER VS. WISDOM","parsedDocumentVersion":94508325},{"blocks":[{"kind":"paragraph","page":9,"text":"The  teaching  structures  personal  finance  into  five  practical  pillars.  To  be  a  faithful  steward,  one  must systematically build and implement systems across each of these categories:","blockId":"f95b27d2-c234-738f-87ee-cf404117fd5a","sectionId":"05d93e71-77f1-79af-903f-44645f4eca12"}],"issues":[],"tables":[],"figures":[],"pageEnd":9,"pageStart":9,"sectionId":"05d93e71-77f1-79af-903f-44645f4eca12","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","sectionHeading":"The Operational Framework for Financial Faithfulness","parsedDocumentVersion":94508325}],"generatedAdditions":[]}],"lessonVersionId":"01a0cb46-449b-7dcb-ba9d-6c18b06e8f1f","groundingCheckId":null,"sourceSnapshotId":"01a0cacd-ada1-7d9c-b0a0-a25de9158d02","lessonSpecRevision":14,"sourceSnapshotContentHash":"9c4bbd04d94cf9242ae2fa11ad3e8f7172f9445b507c65be9e9c2eef9128f09a"},"narration":{"set":{"id":"01a0cad9-e117-78bd-8a12-b19453113c26","model":"moonshotai/Kimi-K3","status":"approved","promptId":"narration","revision":0,"createdAt":"2026-09-22T20:41:11.703Z","projectId":"01a0cacc-4547-7835-b7c4-fcd924b96a92","updatedAt":"2026-09-22T20:42:08.846Z","generatedAt":"2026-09-22T20:41:11.703Z","modelCallId":"01a0cad9-e117-7079-9694-5d0581c32eb1","ownerUserId":"01a0c938-7551-7405-a9e1-4db43e6bc491","outlineSetId":"01a0cad5-389d-7228-9f90-d037d4f13282","promptVersion":"v3","idempotencyKey":"narration.generate:01a0cacc-4547-7835-b7c4-fcd924b96a92:narration:01a0cacd-ada1-7d9c-b0a0-a25de9158d02:9c4bbd04d94cf9242ae2fa11ad3e8f7172f9445b507c65be9e9c2eef9128f09a:v3:0a57b90905bdd9869135275545001159729a0898a959f4d05b9063f1af602927:a6072904f556c6155fe71823bbfebce6e6dc99c4094de1748eb89747c8c74403","sourceSnapshotId":"01a0cacd-ada1-7d9c-b0a0-a25de9158d02","configurationVersion":1,"outlineSetContentHash":"0a90daf0a9e81ba5d9d2e6c4588524163234be101ac032749819552648dfc606","totalEstimatedSeconds":180,"sourceSnapshotContentHash":"9c4bbd04d94cf9242ae2fa11ad3e8f7172f9445b507c65be9e9c2eef9128f09a"},"blocks":[{"id":"01a0cad9-e117-7383-a318-2557197f2f88","text":"What if one word meant righteousness, justice, and generosity at the same time? Would it change how you see your faith and your money? Let's explore the Hebrew idea of Tzedakah.","order":1,"setId":"01a0cad9-e117-78bd-8a12-b19453113c26","origin":"generated","revision":0,"createdAt":"2026-09-22T20:41:11.703Z","generated":true,"projectId":"01a0cacc-4547-7835-b7c4-fcd924b96a92","updatedAt":"2026-09-22T20:41:11.703Z","sourceRefs":[{"pageEnd":5,"blockIds":["06034497-9561-73ab-9a48-7e0b4dd07526"],"pageStart":5,"sectionId":"b8b1cd0e-0c38-7a4c-b81c-f5b63a2e5bba","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}],"ownerUserId":"01a0c938-7551-7405-a9e1-4db43e6bc491","outlineItemId":"01a0cad5-389d-7339-abcd-a088304761fe","targetSeconds":20,"estimatedWords":31,"generatedAdditions":[{"kind":"clarification","content":"Would it change how you see your faith and your money?","rationale":"This is a rhetorical follow-up question to connect the hook to the learner's personal life, as specified in the outline description. It is not a factual claim from the source."}]},{"id":"01a0cad9-e117-7e9a-bb7f-098de0027bc7","text":"Every believer has two kinds of righteousness. The first is a gift received by grace through faith. It is a fixed legal credit that never changes. The second is a harvest that can grow and multiply. This harvest shows up as visible works before people. Ignoring either kind creates a dangerous doctrinal imbalance.","order":2,"setId":"01a0cad9-e117-78bd-8a12-b19453113c26","origin":"generated","revision":0,"createdAt":"2026-09-22T20:41:11.703Z","generated":true,"projectId":"01a0cacc-4547-7835-b7c4-fcd924b96a92","updatedAt":"2026-09-22T20:41:11.703Z","sourceRefs":[{"pageEnd":3,"blockIds":["7af22950-46db-75ef-a410-7afe128a90aa","c963b0b0-1108-7ea7-940d-01123d9cc020","d0c0e6db-3dc0-7132-80b1-b30a86bfb826"],"pageStart":3,"sectionId":"ae281305-b489-7168-892d-1b43eb1f6932","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}],"ownerUserId":"01a0c938-7551-7405-a9e1-4db43e6bc491","outlineItemId":"01a0cad5-389d-7031-b76d-c995eeabc236","targetSeconds":30,"estimatedWords":53,"generatedAdditions":[]},{"id":"01a0cad9-e117-7aca-a6a2-9b0d7cfb4d30","text":"The Hebrew word Tzedakah holds three inseparable meanings. First is personal morality, which means refusing to lie or steal. Second is justice, which means acting uprightly in business and legal dealings. Third is charity, which means giving to the poor as a matter of justice. Withholding help when you can give violates Tzedakah. These three must work together in daily conduct.","order":3,"setId":"01a0cad9-e117-78bd-8a12-b19453113c26","origin":"generated","revision":0,"createdAt":"2026-09-22T20:41:11.703Z","generated":true,"projectId":"01a0cacc-4547-7835-b7c4-fcd924b96a92","updatedAt":"2026-09-22T20:41:11.703Z","sourceRefs":[{"pageEnd":5,"blockIds":["06034497-9561-73ab-9a48-7e0b4dd07526","49c29e8f-988b-7974-8e1c-98507766b8dc","74a62c36-c225-74cd-ab8b-4c70bfa21c0c","fe3027da-43fa-7c54-abee-645434318ebe"],"pageStart":5,"sectionId":"b8b1cd0e-0c38-7a4c-b81c-f5b63a2e5bba","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}],"ownerUserId":"01a0c938-7551-7405-a9e1-4db43e6bc491","outlineItemId":"01a0cad5-389d-7d10-b38f-40c5147cf02e","targetSeconds":30,"estimatedWords":61,"generatedAdditions":[]},{"id":"01a0cad9-e117-77a7-82ee-deb4e38a23d0","text":"Kingdom Economics puts fairness above legal rights. If you take a poor debtor's cloak, return it before sundown. Every seven years, debts were canceled in the Jubilee. Landowners left gleanings at field edges for the poor and stranger. This built a safety net directly into profit-making. Workers must be paid promptly, not made to wait. Never exploit someone's desperation for profit. God judges those who oppress the afflicted.","order":4,"setId":"01a0cad9-e117-78bd-8a12-b19453113c26","origin":"generated","revision":0,"createdAt":"2026-09-22T20:41:11.703Z","generated":true,"projectId":"01a0cacc-4547-7835-b7c4-fcd924b96a92","updatedAt":"2026-09-22T20:41:11.703Z","sourceRefs":[{"pageEnd":5,"blockIds":["23d224bd-1662-7e5a-93b1-c26aa4216531","9192540a-67d8-7cd6-8b2a-7c756cd244d9","a8294542-be65-7173-89e6-421f1913a466","b2b17cf5-d046-7435-b026-b9e3ddb02152","f1f0308a-70b9-7c61-bf74-93a6bf2ad067"],"pageStart":5,"sectionId":"0b36c7d7-5424-7634-928c-baea7fb3aa2b","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}],"ownerUserId":"01a0c938-7551-7405-a9e1-4db43e6bc491","outlineItemId":"01a0cad5-389d-79f7-a307-8ebae0b2113d","targetSeconds":35,"estimatedWords":68,"generatedAdditions":[]},{"id":"01a0cad9-e117-7735-895b-c23e1b09c7b5","text":"Moses had miraculous power but was burning out. Jethro taught him structural delegation to survive. Power produces the miracle, but wisdom sustains it. Jesus raised Jairus's daughter, then commanded she be fed. Without wisdom, the miracle would have been lost. Apply this to money: power earns it, wisdom keeps it.","order":5,"setId":"01a0cad9-e117-78bd-8a12-b19453113c26","origin":"generated","revision":0,"createdAt":"2026-09-22T20:41:11.703Z","generated":true,"projectId":"01a0cacc-4547-7835-b7c4-fcd924b96a92","updatedAt":"2026-09-22T20:41:11.703Z","sourceRefs":[{"pageEnd":7,"blockIds":["44fdb66c-c888-7231-9e57-293f33c4efea","afe140a5-8141-7709-8e11-8dfb41acef12"],"pageStart":7,"sectionId":"1ec7b67c-4e37-70cc-8c39-afaab46897f4","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325},{"pageEnd":7,"blockIds":["2f2a6065-ab09-75d0-b83d-f382b614cf54"],"pageStart":7,"sectionId":"27a1c852-016a-7f51-86c4-bea4e36155a1","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}],"ownerUserId":"01a0c938-7551-7405-a9e1-4db43e6bc491","outlineItemId":"01a0cad5-389d-75ce-82bf-327126d5055b","targetSeconds":25,"estimatedWords":50,"generatedAdditions":[{"kind":"analogy","content":"Apply this to money: power earns it, wisdom keeps it.","rationale":"This analogy applies the Jethro and Mark 5 principle to financial stewardship, as required by the outline. It is a direct application, not a source quote."}]},{"id":"01a0cad9-e117-76e3-80b2-9c4b3c99d909","text":"There are five pillars of financial stewardship. They are budgeting, protection, savings, investment, and debt management. Use the 50/30/20 rule to allocate your income. Fifty percent goes to needs like rent and food. Thirty percent goes to wants like dining out. Twenty percent goes to savings and investment. If you earn 100,000 naira, save 20,000 first.","order":6,"setId":"01a0cad9-e117-78bd-8a12-b19453113c26","origin":"generated","revision":0,"createdAt":"2026-09-22T20:41:11.703Z","generated":true,"projectId":"01a0cacc-4547-7835-b7c4-fcd924b96a92","updatedAt":"2026-09-22T20:41:11.703Z","sourceRefs":[{"pageEnd":9,"blockIds":["f95b27d2-c234-738f-87ee-cf404117fd5a"],"pageStart":9,"sectionId":"05d93e71-77f1-79af-903f-44645f4eca12","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325},{"pageEnd":9,"blockIds":["dd8e865f-a031-7bdc-8f60-67cddffe293f"],"pageStart":9,"sectionId":"b9aeaa29-20f7-7aed-9afc-8d6e97474ef2","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}],"ownerUserId":"01a0c938-7551-7405-a9e1-4db43e6bc491","outlineItemId":"01a0cad5-389d-76cd-a462-3d9526f9f602","targetSeconds":25,"estimatedWords":56,"generatedAdditions":[{"kind":"example","content":"If you earn 100,000 naira, save 20,000 first.","rationale":"This is a concrete numerical example to demonstrate the 50/30/20 calculation, as required by the outline. It is not a source quote."}]},{"id":"01a0cad9-e117-7f09-8dd0-2c0d46511cf4","text":"The master gave talents unevenly but expected equal faithfulness. The one-talent servant was condemned for zero growth, not for having less. Righteousness is both a gift and a harvest. Tzedakah demands integrity, justice, and generosity. Kingdom Economics protects the vulnerable. Wisdom must follow power. Build systems across all five pillars.","order":7,"setId":"01a0cad9-e117-78bd-8a12-b19453113c26","origin":"generated","revision":0,"createdAt":"2026-09-22T20:41:11.703Z","generated":true,"projectId":"01a0cacc-4547-7835-b7c4-fcd924b96a92","updatedAt":"2026-09-22T20:41:11.703Z","sourceRefs":[{"pageEnd":7,"blockIds":["49ec6ab8-4041-757d-8594-ceb5170b4b8e"],"pageStart":7,"sectionId":"62712383-7b98-77d3-875f-babdb7c3ef46","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325},{"pageEnd":3,"blockIds":["c963b0b0-1108-7ea7-940d-01123d9cc020"],"pageStart":3,"sectionId":"ae281305-b489-7168-892d-1b43eb1f6932","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325},{"pageEnd":5,"blockIds":["06034497-9561-73ab-9a48-7e0b4dd07526"],"pageStart":5,"sectionId":"b8b1cd0e-0c38-7a4c-b81c-f5b63a2e5bba","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325},{"pageEnd":5,"blockIds":["b29eff38-6707-7ec8-9cc2-3acf8b734309"],"pageStart":5,"sectionId":"0b36c7d7-5424-7634-928c-baea7fb3aa2b","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325},{"pageEnd":7,"blockIds":["44fdb66c-c888-7231-9e57-293f33c4efea"],"pageStart":7,"sectionId":"1ec7b67c-4e37-70cc-8c39-afaab46897f4","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325},{"pageEnd":9,"blockIds":["f95b27d2-c234-738f-87ee-cf404117fd5a"],"pageStart":9,"sectionId":"05d93e71-77f1-79af-903f-44645f4eca12","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}],"ownerUserId":"01a0c938-7551-7405-a9e1-4db43e6bc491","outlineItemId":"01a0cad5-389d-7ecb-b92c-ab7e26018321","targetSeconds":15,"estimatedWords":50,"generatedAdditions":[]}]},"lessonSpec":{"tone":"friendly","title":"Sermon:Giving","voice":{"speakingRate":1.05,"providerVoiceId":"english-aria"},"scenes":[{"id":"01a0cadc-f79e-7747-8e44-ae7329d88b84","order":1,"title":"One Word, Three Meanings","visual":{"prompt":"Meet the Hebrew idea of Tzedakah","question":"What if righteousness, justice, and generosity were one word?","supportingElements":["Righteous?","Just?","Generous?"]},"template":"hook","narration":"What if one word meant righteousness, justice, and generosity at the same time? Would it change how you see your faith and your money? Let's explore the Hebrew idea of Tzedakah.","sourceRefs":[{"pageEnd":5,"blockIds":["06034497-9561-73ab-9a48-7e0b4dd07526"],"pageStart":5,"sectionId":"b8b1cd0e-0c38-7a4c-b81c-f5b63a2e5bba","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}],"transition":"fade","onScreenText":[],"assetBindings":[{"role":"illustration","slot":"subject","assetId":"01a0cae0-9426-7e70-b7ca-5400d108cf8c","provenance":"ai_generated","visualRole":"decorative"}],"durationSeconds":12,"generatedAdditions":[]},{"id":"01a0cadc-f79e-729a-8129-bfaf48faeb59","order":2,"title":"Two Kinds of Righteousness","visual":{"differences":["Gift: received by grace through faith","Gift: fixed legal credit, never changes","Harvest: grows and multiplies","Harvest: visible works before people"],"leftSubject":{"label":"Righteousness as a Gift"},"rightSubject":{"label":"Harvest of Righteousness"},"similarities":["Both must be active in a believer's life"]},"template":"comparison","narration":"Every believer has two kinds of righteousness. The first is a gift received by grace through faith. It is a fixed legal credit that never changes. The second is a harvest that can grow and multiply. This harvest shows up as visible works before people. Ignoring either kind creates a dangerous doctrinal imbalance.","sourceRefs":[{"pageEnd":3,"blockIds":["7af22950-46db-75ef-a410-7afe128a90aa","c963b0b0-1108-7ea7-940d-01123d9cc020","d0c0e6db-3dc0-7132-80b1-b30a86bfb826"],"pageStart":3,"sectionId":"ae281305-b489-7168-892d-1b43eb1f6932","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}],"transition":"cut","onScreenText":[],"assetBindings":[{"role":"illustration","slot":"right-subject-image","assetId":"01a0cae4-f700-7f19-9adb-200f31c3caeb","provenance":"ai_generated","visualRole":"decorative"},{"role":"illustration","slot":"left-subject-image","assetId":"01a0cae4-cf10-78b7-8a79-e25f2dde797e","provenance":"ai_generated","visualRole":"decorative"}],"durationSeconds":19,"generatedAdditions":[]},{"id":"01a0cadc-f79e-7354-95cb-9e0b6787e590","order":3,"title":"Tzedakah","visual":{"term":"Tzedakah","definition":"One Hebrew word uniting morality, justice, and charity as inseparable duties.","exampleText":"Refusing to give when you can violates Tzedakah.","exampleLabel":"Withholding help"},"template":"definition","narration":"The Hebrew word Tzedakah holds three inseparable meanings. First is personal morality, which means refusing to lie or steal. Second is justice, which means acting uprightly in business and legal dealings. Third is charity, which means giving to the poor as a matter of justice. Withholding help when you can give violates Tzedakah. These three must work together in daily conduct.","sourceRefs":[{"pageEnd":5,"blockIds":["06034497-9561-73ab-9a48-7e0b4dd07526","49c29e8f-988b-7974-8e1c-98507766b8dc","74a62c36-c225-74cd-ab8b-4c70bfa21c0c","fe3027da-43fa-7c54-abee-645434318ebe"],"pageStart":5,"sectionId":"b8b1cd0e-0c38-7a4c-b81c-f5b63a2e5bba","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}],"transition":"cut","onScreenText":[],"assetBindings":[{"role":"illustration","slot":"visual-example","assetId":"01a0cae0-b4b7-7c4b-b8c0-d6037f2b7ae2","provenance":"ai_generated","visualRole":"decorative"}],"durationSeconds":23,"generatedAdditions":[]},{"id":"01a0cadc-f79e-7dba-8053-24768f2d1aca","order":4,"title":"Kingdom Economics in Action","visual":{"steps":["Return a poor debtor's cloak before sundown","Cancel debts every seven years (Jubilee)","Leave field-edge gleanings for the poor","Pay workers promptly","Never exploit desperation for profit"]},"template":"process","narration":"Kingdom Economics puts fairness above legal rights. If you take a poor debtor's cloak, return it before sundown. Every seven years, debts were canceled in the Jubilee. Landowners left gleanings at field edges for the poor and stranger. This built a safety net directly into profit-making. Workers must be paid promptly, not made to wait. Never exploit someone's desperation for profit. God judges those who oppress the afflicted.","sourceRefs":[{"pageEnd":5,"blockIds":["23d224bd-1662-7e5a-93b1-c26aa4216531","9192540a-67d8-7cd6-8b2a-7c756cd244d9","a8294542-be65-7173-89e6-421f1913a466","b29eff38-6707-7ec8-9cc2-3acf8b734309","b2b17cf5-d046-7435-b026-b9e3ddb02152","f1f0308a-70b9-7c61-bf74-93a6bf2ad067"],"pageStart":5,"sectionId":"0b36c7d7-5424-7634-928c-baea7fb3aa2b","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}],"transition":"cut","onScreenText":[],"assetBindings":[{"role":"icon","slot":"step-5-icon","assetId":"01a0cae0-7228-716c-a380-c8c38e3d4fd0","provenance":"ai_generated","visualRole":"decorative"},{"role":"icon","slot":"step-4-icon","assetId":"01a0cae0-4e1c-78aa-8b7a-73a06b5ed4ed","provenance":"ai_generated","visualRole":"decorative"},{"role":"icon","slot":"step-3-icon","assetId":"01a0cae0-2872-7ad1-8d13-b55b6e7ed106","provenance":"ai_generated","visualRole":"decorative"},{"role":"icon","slot":"step-2-icon","assetId":"01a0cae0-03bf-7a65-8f7e-51267476fdd0","provenance":"ai_generated","visualRole":"decorative"},{"role":"icon","slot":"step-1-icon","assetId":"01a0cadf-d363-725e-8931-78ad3bb235cf","provenance":"ai_generated","visualRole":"decorative"}],"durationSeconds":28,"generatedAdditions":[]},{"id":"01a0cadc-f79e-7aae-a0b7-c95171972638","order":5,"title":"Power Produces, Wisdom Sustains","visual":{"mappings":[{"analogy":"Power parted the sea","concept":"Moses' miracles"},{"analogy":"Wisdom stopped burnout","concept":"Jethro's delegation"},{"analogy":"Power gave life","concept":"Raising Jairus's daughter"},{"analogy":"Wisdom kept her alive","concept":"Commanding she be fed"}],"sourceConcept":"God's power vs. God's wisdom","familiarSystem":"Miracle then maintenance"},"template":"analogy","narration":"Moses had miraculous power but was burning out. Jethro taught him structural delegation to survive. Power produces the miracle, but wisdom sustains it. Jesus raised Jairus's daughter, then commanded she be fed. Without wisdom, the miracle would have been lost. Apply this to money: power earns it, wisdom keeps it.","sourceRefs":[{"pageEnd":7,"blockIds":["44fdb66c-c888-7231-9e57-293f33c4efea","afe140a5-8141-7709-8e11-8dfb41acef12"],"pageStart":7,"sectionId":"1ec7b67c-4e37-70cc-8c39-afaab46897f4","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325},{"pageEnd":7,"blockIds":["2f2a6065-ab09-75d0-b83d-f382b614cf54"],"pageStart":7,"sectionId":"27a1c852-016a-7f51-86c4-bea4e36155a1","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}],"transition":"cut","onScreenText":[],"assetBindings":[{"role":"illustration","slot":"central-visual","assetId":"01a0cae0-d61b-7b3e-9ce8-017ad7eb2831","provenance":"ai_generated","visualRole":"decorative"}],"durationSeconds":20,"generatedAdditions":[]},{"id":"01a0cadc-f79e-7314-8fb8-ec7b7b8fa0d7","order":6,"title":"Five Pillars and the 50/30/20 Rule","visual":{"kind":"asset","shape":"system","labels":[{"id":"lbl-budgeting","text":"Budgeting","anchor":"top-left"},{"id":"lbl-protection","text":"Protection","anchor":"top-right"},{"id":"lbl-savings","text":"Savings","anchor":"left"},{"id":"lbl-investment","text":"Investment","anchor":"right"},{"id":"lbl-debt","text":"Debt management","anchor":"bottom"}],"baseAssetSlot":"diagram"},"template":"labelled-diagram","narration":"There are five pillars of financial stewardship. They are budgeting, protection, savings, investment, and debt management. Use the 50/30/20 rule to allocate your income. Fifty percent goes to needs like rent and food. Thirty percent goes to wants like dining out. Twenty percent goes to savings and investment. If you earn 100,000 naira, save 20,000 first.","sourceRefs":[{"pageEnd":9,"blockIds":["f95b27d2-c234-738f-87ee-cf404117fd5a"],"pageStart":9,"sectionId":"05d93e71-77f1-79af-903f-44645f4eca12","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325},{"pageEnd":9,"blockIds":["dd8e865f-a031-7bdc-8f60-67cddffe293f"],"pageStart":9,"sectionId":"b9aeaa29-20f7-7aed-9afc-8d6e97474ef2","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}],"transition":"cut","onScreenText":["50% needs, 30% wants, 20% savings & investment","Earn 100,000 naira? Save 20,000 first."],"assetBindings":[{"role":"diagram","slot":"diagram","assetId":"211b6fd2-19e2-7eef-bf16-b89db79c6a67"}],"durationSeconds":22,"generatedAdditions":[]},{"id":"01a0cadc-f79e-76a9-a2bc-1f81bf3e8af1","order":7,"title":"Faithfulness Is the Standard","visual":{"takeaways":[{"text":"Righteousness is both a gift and a growing harvest"},{"text":"Tzedakah demands integrity, justice, and generosity"},{"text":"Kingdom Economics protects the vulnerable"},{"text":"Build systems across all five pillars"}],"centralModel":"The one-talent servant fell for zero growth, not for having less."},"template":"summary","narration":"The master gave talents unevenly but expected equal faithfulness. The one-talent servant was condemned for zero growth, not for having less. Righteousness is both a gift and a harvest. Tzedakah demands integrity, justice, and generosity. Kingdom Economics protects the vulnerable. Wisdom must follow power. Build systems across all five pillars.","sourceRefs":[{"pageEnd":7,"blockIds":["49ec6ab8-4041-757d-8594-ceb5170b4b8e"],"pageStart":7,"sectionId":"62712383-7b98-77d3-875f-babdb7c3ef46","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325},{"pageEnd":5,"blockIds":["06034497-9561-73ab-9a48-7e0b4dd07526"],"pageStart":5,"sectionId":"b8b1cd0e-0c38-7a4c-b81c-f5b63a2e5bba","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325},{"pageEnd":7,"blockIds":["44fdb66c-c888-7231-9e57-293f33c4efea"],"pageStart":7,"sectionId":"1ec7b67c-4e37-70cc-8c39-afaab46897f4","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325},{"pageEnd":9,"blockIds":["f95b27d2-c234-738f-87ee-cf404117fd5a"],"pageStart":9,"sectionId":"05d93e71-77f1-79af-903f-44645f4eca12","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}],"transition":"fade","onScreenText":[],"assetBindings":[],"durationSeconds":24,"generatedAdditions":[]}],"subject":"Riches","themeId":"mvp-default","audience":{"ageBand":"adult-beginner","difficulty":"intermediate","priorKnowledge":[]},"lessonId":"01a0cadc-f79e-798c-8f27-169a3d5b7505","projectId":"01a0cacc-4547-7835-b7c4-fcd924b96a92","objectiveIds":["01a0cace-ecd7-7355-b1db-e3dafa507991","01a0cace-ecd7-7970-8683-661a513bb105","01a0cace-ecd7-7b8d-9e03-abc39630db01","01a0cace-ecd7-7a1a-9412-52d954644606","01a0cace-ecd7-7239-afef-9a0413bb4e1c","01a0cace-ecd7-7bc6-ae8b-1812d9d98dc6"],"schemaVersion":"1.8","targetDurationSeconds":180},"objectives":{"set":{"id":"01a0cace-ecd7-7668-ac5b-3ad7214dee32","model":"moonshotai/Kimi-K3","status":"approved","promptId":"objectives","revision":0,"createdAt":"2026-09-22T20:29:13.815Z","projectId":"01a0cacc-4547-7835-b7c4-fcd924b96a92","updatedAt":"2026-09-22T20:31:45.136Z","vocabulary":[{"id":"01a0cace-ecd7-7c13-bb07-eab21dc97fec","term":"Positional Righteousness","order":1,"definition":"Righteousness received as a gift by grace through faith, a fixed legal credit that cannot be increased or diminished.","sourceRefs":[{"pageEnd":3,"blockIds":["7af22950-46db-75ef-a410-7afe128a90aa"],"pageStart":3,"sectionId":"ae281305-b489-7168-892d-1b43eb1f6932","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}]},{"id":"01a0cace-ecd7-7c3b-8fff-e8bf58489812","term":"Harvest of Righteousness","order":2,"definition":"The dynamic, visible fruits and works of righteousness before people, which can and should be multiplied.","sourceRefs":[{"pageEnd":3,"blockIds":["d0c0e6db-3dc0-7132-80b1-b30a86bfb826"],"pageStart":3,"sectionId":"ae281305-b489-7168-892d-1b43eb1f6932","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}]},{"id":"01a0cace-ecd7-74c5-9ae4-546c3def9a80","term":"Tzedakah","order":3,"definition":"The Hebrew word (T-Z-E-D-A-K-A-H) that treats morality, justice, and charity as inseparable parts of one whole.","sourceRefs":[{"pageEnd":5,"blockIds":["06034497-9561-73ab-9a48-7e0b4dd07526"],"pageStart":5,"sectionId":"b8b1cd0e-0c38-7a4c-b81c-f5b63a2e5bba","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}]},{"id":"01a0cace-ecd7-7b57-993b-9e7083931f37","term":"Sowing Sparingly","order":4,"definition":"Giving out of reluctant compulsion or exhaustion, lacking excitement or love; a state of the giver's heart, not just an amount.","sourceRefs":[{"pageEnd":3,"blockIds":["19d141cb-9c20-7966-8416-afe5863ec966"],"pageStart":3,"sectionId":"945ac743-1f71-77fb-a524-2fe425066f93","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}]},{"id":"01a0cace-ecd7-7307-bed2-070ed13cbed2","term":"Gleanings","order":5,"definition":"The corners and unharvested produce left in fields for the poor, the widow, and the stranger as a built-in safety net.","sourceRefs":[{"pageEnd":5,"blockIds":["a8294542-be65-7173-89e6-421f1913a466"],"pageStart":5,"sectionId":"0b36c7d7-5424-7634-928c-baea7fb3aa2b","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}]},{"id":"01a0cace-ecd7-7814-978e-867ca029f928","term":"Steward","order":6,"definition":"A manager of God's property rather than an independent owner; in the Kingdom economy, owners are treated as rebels.","sourceRefs":[{"pageEnd":7,"blockIds":["2e7f2eb1-2d9f-71fc-863c-14b5cea9acaf"],"pageStart":7,"sectionId":"62712383-7b98-77d3-875f-babdb7c3ef46","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}]},{"id":"01a0cace-ecd7-7962-a88d-8adfac2c73d7","term":"Budget","order":7,"definition":"A written plan for your money before it arrives.","sourceRefs":[{"pageEnd":9,"blockIds":["d8d10398-fc31-7207-8067-7d205b09e480"],"pageStart":9,"sectionId":"b9aeaa29-20f7-7aed-9afc-8d6e97474ef2","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}]},{"id":"01a0cace-ecd7-722e-972d-091a5973ef23","term":"50/30/20 Rule","order":8,"definition":"An allocation formula: 50% needs, 30% wants, 20% savings and investment, with savings growing as income grows.","sourceRefs":[{"pageEnd":9,"blockIds":["dd8e865f-a031-7bdc-8f60-67cddffe293f"],"pageStart":9,"sectionId":"b9aeaa29-20f7-7aed-9afc-8d6e97474ef2","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}]},{"id":"01a0cace-ecd7-7088-afb9-7104cb79125d","term":"Emergency Fund","order":9,"definition":"A liquid reserve of 3 to 6 months of living expenses that prevents breaking long-term investments in a crisis.","sourceRefs":[{"pageEnd":9,"blockIds":["19c878fa-239b-717b-b639-679449af7ad3","dbdda288-96d0-79a1-acf2-e6a27600477d"],"pageStart":9,"sectionId":"f9ed18f5-bfbf-78af-a209-208907dfac30","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}]},{"id":"01a0cace-ecd7-7f9c-8613-7c9401997d28","term":"Risk Tolerance","order":10,"definition":"The level of investment risk a person can handle, which must be understood by investing in knowledge before investing money.","sourceRefs":[{"pageEnd":11,"blockIds":["66e311a8-add0-7a1d-8ef6-093444c88a60"],"pageStart":11,"sectionId":"db102ffa-82bb-745f-be36-1708b4b455c4","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}]}],"generatedAt":"2026-09-22T20:29:13.815Z","keyConcepts":[{"id":"01a0cace-ecd7-792b-9cc4-1eba45825ab0","text":"Two manifestations of righteousness: gift (positional) versus harvest (practical)","order":1,"sourceRefs":[{"pageEnd":3,"blockIds":["7af22950-46db-75ef-a410-7afe128a90aa","c963b0b0-1108-7ea7-940d-01123d9cc020","d0c0e6db-3dc0-7132-80b1-b30a86bfb826"],"pageStart":3,"sectionId":"ae281305-b489-7168-892d-1b43eb1f6932","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}]},{"id":"01a0cace-ecd7-7dfc-8c1d-2e9182171a59","text":"Generosity as a willing overflow of righteousness rather than forced compliance","order":2,"sourceRefs":[{"pageEnd":3,"blockIds":["19d141cb-9c20-7966-8416-afe5863ec966"],"pageStart":3,"sectionId":"945ac743-1f71-77fb-a524-2fe425066f93","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}]},{"id":"01a0cace-ecd7-7070-bdc1-3db31f7bd64b","text":"Tzedakah unites personal morality, justice, and charity into one whole","order":3,"sourceRefs":[{"pageEnd":5,"blockIds":["06034497-9561-73ab-9a48-7e0b4dd07526","49c29e8f-988b-7974-8e1c-98507766b8dc","74a62c36-c225-74cd-ab8b-4c70bfa21c0c","fe3027da-43fa-7c54-abee-645434318ebe"],"pageStart":5,"sectionId":"b8b1cd0e-0c38-7a4c-b81c-f5b63a2e5bba","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}]},{"id":"01a0cace-ecd7-7d99-a747-72bd5f757dd9","text":"Kingdom Economics laws: fairness over legal rights, debt cancellation, gleanings, prompt wages, refusing exploitation","order":4,"sourceRefs":[{"pageEnd":5,"blockIds":["23d224bd-1662-7e5a-93b1-c26aa4216531","9192540a-67d8-7cd6-8b2a-7c756cd244d9","a8294542-be65-7173-89e6-421f1913a466","b29eff38-6707-7ec8-9cc2-3acf8b734309","b2b17cf5-d046-7435-b026-b9e3ddb02152","f1f0308a-70b9-7c61-bf74-93a6bf2ad067"],"pageStart":5,"sectionId":"0b36c7d7-5424-7634-928c-baea7fb3aa2b","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}]},{"id":"01a0cace-ecd7-7a13-aa84-81fd72f59dee","text":"Power produces the miracle; wisdom sustains it","order":5,"sourceRefs":[{"pageEnd":7,"blockIds":["44fdb66c-c888-7231-9e57-293f33c4efea"],"pageStart":7,"sectionId":"1ec7b67c-4e37-70cc-8c39-afaab46897f4","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325},{"pageEnd":7,"blockIds":["2f2a6065-ab09-75d0-b83d-f382b614cf54"],"pageStart":7,"sectionId":"27a1c852-016a-7f51-86c4-bea4e36155a1","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}]},{"id":"01a0cace-ecd7-7d6a-8534-12f9bcbfc19c","text":"Stewardship: God gives the power to get wealth and demands accountability","order":6,"sourceRefs":[{"pageEnd":7,"blockIds":["2e7f2eb1-2d9f-71fc-863c-14b5cea9acaf","49ec6ab8-4041-757d-8594-ceb5170b4b8e"],"pageStart":7,"sectionId":"62712383-7b98-77d3-875f-babdb7c3ef46","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}]},{"id":"01a0cace-ecd7-7675-ad05-0967e85dd6d7","text":"Five pillars of financial faithfulness: budgeting/tracking, protection, savings, investment, debt management","order":7,"sourceRefs":[{"pageEnd":9,"blockIds":["f95b27d2-c234-738f-87ee-cf404117fd5a"],"pageStart":9,"sectionId":"05d93e71-77f1-79af-903f-44645f4eca12","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325},{"pageEnd":9,"blockIds":["d8d10398-fc31-7207-8067-7d205b09e480"],"pageStart":9,"sectionId":"b9aeaa29-20f7-7aed-9afc-8d6e97474ef2","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325},{"pageEnd":9,"blockIds":["19c878fa-239b-717b-b639-679449af7ad3"],"pageStart":9,"sectionId":"f9ed18f5-bfbf-78af-a209-208907dfac30","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325},{"pageEnd":9,"blockIds":["7a32b18c-fe32-715f-b6f2-3ef07a0836cf"],"pageStart":9,"sectionId":"9a6de675-995a-7740-ab5b-26f425655e0a","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325},{"pageEnd":11,"blockIds":["66e311a8-add0-7a1d-8ef6-093444c88a60"],"pageStart":11,"sectionId":"db102ffa-82bb-745f-be36-1708b4b455c4","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325},{"pageEnd":11,"blockIds":["09df5ee4-b668-7289-9457-76279f00717b"],"pageStart":11,"sectionId":"5d29fd16-f27e-7798-bd4a-a3c77b40545d","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}]}],"modelCallId":"01a0cace-ecd7-75ef-acbe-73f2938e990f","ownerUserId":"01a0c938-7551-7405-a9e1-4db43e6bc491","promptVersion":"v2","idempotencyKey":"objectives.generate:01a0cacc-4547-7835-b7c4-fcd924b96a92:objectives:01a0cacd-ada1-7d9c-b0a0-a25de9158d02:9c4bbd04d94cf9242ae2fa11ad3e8f7172f9445b507c65be9e9c2eef9128f09a:v2:8f2105d5dbadbcee68ef2dea5479e58606a6c9f025b1b65a221886e52910dc10:babdb06f58469cec7fe80bf7fb7f8d8dc91e47ca117caf46ace5c25ce955af75","misconceptions":[{"id":"01a0cace-ecd7-7a3f-95a0-02667ad6a12f","order":1,"correction":"The gift of righteousness is fixed, but the harvest of righteousness must be multiplied; works do not qualify us before God but demonstrate faith before people.","sourceRefs":[{"pageEnd":3,"blockIds":["d0c0e6db-3dc0-7132-80b1-b30a86bfb826"],"pageStart":3,"sectionId":"ae281305-b489-7168-892d-1b43eb1f6932","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325},{"pageEnd":3,"blockIds":["c2a2b9c1-12af-73f2-84f0-432fe91a4b6a"],"pageStart":3,"sectionId":"a34c7386-4622-7b06-9259-8ceace8dbdb8","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}],"misconception":"Because righteousness is a gift, works are unnecessary."},{"id":"01a0cace-ecd7-7414-bc14-fdfe11435709","order":2,"correction":"Sowing sparingly describes the state of the giver's heart-reluctant compulsion or exhaustion-not merely the financial quantity.","sourceRefs":[{"pageEnd":3,"blockIds":["19d141cb-9c20-7966-8416-afe5863ec966"],"pageStart":3,"sectionId":"945ac743-1f71-77fb-a524-2fe425066f93","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}],"misconception":"Sowing sparingly is only about giving a small amount of money."},{"id":"01a0cace-ecd7-7a77-9f26-520c65153de3","order":3,"correction":"In the Hebrew scriptures, giving to the poor is classified as justice and righteousness; withholding help when you have power to give violates Tzedakah.","sourceRefs":[{"pageEnd":5,"blockIds":["49c29e8f-988b-7974-8e1c-98507766b8dc"],"pageStart":5,"sectionId":"b8b1cd0e-0c38-7a4c-b81c-f5b63a2e5bba","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}],"misconception":"Giving to the poor is optional benevolence."},{"id":"01a0cace-ecd7-76b1-842a-bd56ed30ecef","order":4,"correction":"Power and wisdom are distinct yet both necessary; without wisdom to organize and structure, a person will burn out and destroy what was built-power produces the miracle, wisdom sustains it.","sourceRefs":[{"pageEnd":7,"blockIds":["44fdb66c-c888-7231-9e57-293f33c4efea"],"pageStart":7,"sectionId":"1ec7b67c-4e37-70cc-8c39-afaab46897f4","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325},{"pageEnd":7,"blockIds":["2f2a6065-ab09-75d0-b83d-f382b614cf54"],"pageStart":7,"sectionId":"27a1c852-016a-7f51-86c4-bea4e36155a1","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}],"misconception":"Having the power of God is enough to sustain a blessed life."},{"id":"01a0cace-ecd7-7e96-bf79-a3055dab3fec","order":5,"correction":"Your current financial level is a stewardship test; if you cannot manage 200,000 naira, 20 million will only enable more expensive mistakes.","sourceRefs":[{"pageEnd":7,"blockIds":["49ec6ab8-4041-757d-8594-ceb5170b4b8e"],"pageStart":7,"sectionId":"62712383-7b98-77d3-875f-babdb7c3ef46","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}],"misconception":"A bigger amount of money will solve money problems."},{"id":"01a0cace-ecd7-7801-8f13-476d334665f3","order":6,"correction":"Inflation and bank maintenance fees and levies slowly deplete idle capital; investment requires first investing in knowledge and understanding risk.","sourceRefs":[{"pageEnd":11,"blockIds":["66e311a8-add0-7a1d-8ef6-093444c88a60"],"pageStart":11,"sectionId":"db102ffa-82bb-745f-be36-1708b4b455c4","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}],"misconception":"Leaving money in a bank account is a safe investment strategy."}],"sourceSnapshotId":"01a0cacd-ada1-7d9c-b0a0-a25de9158d02","assessmentQuestions":[{"id":"01a0cace-ecd7-714b-809f-d23e7d4857c9","order":1,"question":"In your own words, what is the difference between righteousness as a gift and the harvest of righteousness?","sourceRefs":[{"pageEnd":3,"blockIds":["7af22950-46db-75ef-a410-7afe128a90aa","d0c0e6db-3dc0-7132-80b1-b30a86bfb826"],"pageStart":3,"sectionId":"ae281305-b489-7168-892d-1b43eb1f6932","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}]},{"id":"01a0cace-ecd7-7677-b76f-a9e0300175f2","order":2,"question":"Name the three ramifications of Tzedakah and give one everyday example of each.","sourceRefs":[{"pageEnd":5,"blockIds":["06034497-9561-73ab-9a48-7e0b4dd07526","49c29e8f-988b-7974-8e1c-98507766b8dc","74a62c36-c225-74cd-ab8b-4c70bfa21c0c","fe3027da-43fa-7c54-abee-645434318ebe"],"pageStart":5,"sectionId":"b8b1cd0e-0c38-7a4c-b81c-f5b63a2e5bba","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}]},{"id":"01a0cace-ecd7-7ff2-bb12-ef0f010f7916","order":3,"question":"Choose two Kingdom Economics laws from the sermon and explain how each one protects poor or vulnerable people.","sourceRefs":[{"pageEnd":5,"blockIds":["23d224bd-1662-7e5a-93b1-c26aa4216531","9192540a-67d8-7cd6-8b2a-7c756cd244d9","a8294542-be65-7173-89e6-421f1913a466","b2b17cf5-d046-7435-b026-b9e3ddb02152","f1f0308a-70b9-7c61-bf74-93a6bf2ad067"],"pageStart":5,"sectionId":"0b36c7d7-5424-7634-928c-baea7fb3aa2b","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}]},{"id":"01a0cace-ecd7-7113-9985-99c6a1a954c3","order":4,"question":"After Jesus raised Jairus's daughter, why did He command that she be given something to eat, and what does this teach about money management?","sourceRefs":[{"pageEnd":7,"blockIds":["2f2a6065-ab09-75d0-b83d-f382b614cf54"],"pageStart":7,"sectionId":"27a1c852-016a-7f51-86c4-bea4e36155a1","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}]},{"id":"01a0cace-ecd7-7b43-89a5-da73a5c1c879","order":5,"question":"If your monthly income is 100,000 naira, use the 50/30/20 rule to calculate how much should go to needs, wants, and savings/investment.","sourceRefs":[{"pageEnd":9,"blockIds":["dd8e865f-a031-7bdc-8f60-67cddffe293f"],"pageStart":9,"sectionId":"b9aeaa29-20f7-7aed-9afc-8d6e97474ef2","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}]},{"id":"01a0cace-ecd7-71d3-b7dc-6755f130b1d4","order":6,"question":"Why was the one-talent servant condemned even though he did not lose the money?","sourceRefs":[{"pageEnd":7,"blockIds":["49ec6ab8-4041-757d-8594-ceb5170b4b8e"],"pageStart":7,"sectionId":"62712383-7b98-77d3-875f-babdb7c3ef46","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}]}],"configurationVersion":1,"prerequisiteKnowledge":[{"id":"01a0cace-ecd7-7dde-93f9-c630e3749e5f","text":"Basic familiarity with the Biblical narrative of David and Goliath and the roles of Goliath and King Saul","order":1,"sourceRefs":[{"pageEnd":3,"blockIds":["c2a2b9c1-12af-73f2-84f0-432fe91a4b6a"],"pageStart":3,"sectionId":"a34c7386-4622-7b06-9259-8ceace8dbdb8","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}]},{"id":"01a0cace-ecd7-7335-a474-ed6de56a31ac","text":"Awareness that the sermons draw on specific scriptures such as Proverbs 8:18, 2 Corinthians 9, and Acts 20:32","order":2,"sourceRefs":[{"pageEnd":3,"blockIds":["1259c33f-c13b-733f-a31b-eac5bd884c63"],"pageStart":3,"sectionId":"8b3a2fbf-ae3e-7b3b-9c8e-2dfb5570438f","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325},{"pageEnd":7,"blockIds":["56a5c45d-a5ef-700a-a272-89b5569a62ea"],"pageStart":7,"sectionId":"50ab6b8a-cab7-76cd-8432-fb39f839dbed","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325},{"pageEnd":3,"blockIds":["19d141cb-9c20-7966-8416-afe5863ec966"],"pageStart":3,"sectionId":"945ac743-1f71-77fb-a524-2fe425066f93","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a5c","parsedDocumentVersion":94508325}]},{"id":"01a0cace-ecd7-7898-bb66-15571a6f6b14","text":"General understanding of money terms used in the sermons such as income, expenses, debt, savings, and interest","order":3,"sourceRefs":[{"pageEnd":7,"blockIds":["49ec6ab8-4041-757d-8594-ceb5170b4b8e"],"pageStart":7,"sectionId":"62712383-7b98-77d3-875f-babdb7c3ef46","documentId":"147dae4b-e3d7-7b84-8397-e1bf5d641a