{"timestamp":"2026-09-28T10:26:12.807Z","level":"info","event":"provider.together.response","fields":{"provider":"together","endpoint":"/chat/completions","response":{"httpStatus":200,"contentType":"text/event-stream","providerRequestId":"11c055ea-aws_ec1","model":"moonshotai/Kimi-K3","text":"{\n  \"schemaVersion\": \"storyboard-v1\",\n  \"targetDurationSeconds\": 300,\n  \"scenes\": [\n    {\n      \"template\": \"hook\",\n      \"title\": \"Can You Keep What God Gives?\",\n      \"narrationBlockIds\": [\"01a0e78b-6d8f-7c10-beee-061da9747bb3\"],\n      \"onScreenText\": [],\n      \"visual\": {\n        \"question\": \"Why do so many breakthroughs slip away?\",\n        \"prompt\": \"A raise, a windfall, an open door...\",\n        \"supportingElements\": [\n          \"Sudden provision is common\",\n          \"Keeping it is rare\",\n          \"Consecration + practical wisdom\"\n        ]\n      },\n      \"estimatedSeconds\": 30,\n      \"transition\": \"fade\",\n      \"sourceBlockIds\": [\"20f4dd95-70c7-707b-84a2-7655261b6e2a\"],\n      \"generatedAdditions\": [],\n      \"assetRequirements\": [\n        {\n          \"slot\": \"subject\",\n          \"purpose\": \"Warm illustration of a financial breakthrough (raise or windfall) to frame the opening question\"\n        }\n      ]\n    },\n    {\n      \"template\": \"cause-effect\",\n      \"title\": \"Enduring Riches Travel the Path of Righteousness\",\n      \"narrationBlockIds\": [\"01a0e78b-6d8f-7d53-93c4-89acc28671d6\"],\n      \"onScreenText\": [],\n      \"visual\": {\n        \"causes\": [\n          { \"id\": \"love-god\", \"label\": \"Love God\" },\n          { \"id\": \"consecration\", \"label\": \"Spiritual consecration\" }\n        ],\n        \"mechanism\": { \"id\": \"wisdom-path\", \"label\": \"Wisdom walks the way of righteousness (Prov 8)\" },\n        \"effects\": [\n          { \"id\": \"inherit-wealth\", \"label\": \"Inherit wealth\" },\n          { \"id\": \"filled-treasuries\", \"label\