{"timestamp":"2026-09-28T10:25:26.152Z","level":"info","event":"provider.together.response","fields":{"provider":"together","endpoint":"/chat/completions","response":{"httpStatus":200,"contentType":"text/event-stream","providerRequestId":"79f4f349-aws_ec1","model":"moonshotai/Kimi-K3","text":"{\n  \"schemaVersion\": \"narration-v1\",\n  \"targetDurationSeconds\": 300,\n  \"blocks\": [\n    {\n      \"outlineItemId\": \"01a0e765-16c7-7424-9e82-0abf7a917a11\",\n      \"sentences\": [\n        {\n          \"text\": \"Have you ever received a financial breakthrough—a raise, a windfall, a new opportunity—only to watch it slip away?\",\n          \"sourceBlockIds\": [],\n          \"generatedAddition\": {\n            \"kind\": \"illustration\",\n            \"rationale\": \"Poses the driving question about sudden financial gains that vanish, engaging adult learners with a common experience to frame the lesson's focus on maintaining wealth.\"\n          }\n        },\n        {\n          \"text\": \"Many experience sudden provision, but few know how to keep it.\",\n          \"sourceBlockIds\": [],\n          \"generatedAddition\": {\n            \"kind\": \"clarification\",\n            \"rationale\": \"Summarizes the core problem of fleeting financial breakthroughs to motivate the biblical perspective on enduring riches.\"\n          }\n        },\n        {\n          \"text\": \"This series from Celebration Church International pairs spiritual consecration with practical financial wisdom to address that gap.\",\n          \"sourceBlockIds\": [\"20f4dd95-70c7-707b-84a2-7655261b6e2a\"]\n        },\n        {\n          \"text\": \"It teaches not only how enduring riches come, but how they are maintained.\",\n          \"sourceBlockIds\": [\"20f4dd95-70c7-707b-84a2-7655261b6e2a\"]\n        }\n      ]\n    },\n    {\n      \"outlineItemId\": \"01a0e765-16c7-7ed9-a4fe-f24ac7ee6b3b\",\n      \"sentences\": [\n        {\n          \"text\": \"The anchor text is Proverbs 8, where wisdom declares that enduring riches and righteousness travel together.\",\n          \"sourceBlockIds\": [\"cf7d310a-6de0-74c7-ad07-376e2611955f\"]\n        },\n        {\n          \"text\": \"Wisdom says, \\\"I traverse the way of righteousness in the midst of the paths of justice,\\\" to fill the treasuries of those who love God.\",\n          \"sourceBlockIds\": [\"cf7d310a-6de0-74c7-ad07-376e2611955f\"],\n   ","textChunks":["{\n  \"schemaVersion\": \"narration-v1\",\n  \"targetDurationSeconds\": 300,\n  \"blocks\": [\n    {\n      \"outlineItemId\": \"01a0e765-16c7-7424-9e82-0abf7a917a11\",\n      \"sentences\": [\n        {\n          \"text\": \"Have you ever received a financial breakthrough—a raise, a windfall, a new opportunity—only to watch it slip away?\",\n          \"sourceBlockIds\": [],\n          \"generatedAddition\": {\n            \"kind\": \"illustration\",\n            \"rationale\": \"Poses the driving question about sudden financial gains that vanish, engaging adult learners with a common experience to frame the lesson's focus on maintaining wealth.\"\n          }\n        },\n        {\n          \"text\": \"Many experience sudden provision, but few know how to keep it.\",\n          \"sourceBlockIds\": [],\n          \"generatedAddition\": {\n            \"kind\": \"clarification\",\n            \"rationale\": \"Summarizes the core problem of fleeting financial breakthroughs to motivate the biblical perspective on enduring riches.\"\n          }\n        },\n        {\n          \"text\": \"This series from Celebration Church International pairs spiritual consecration with practical financial wisdom to address that gap.\",\n          \"sourceBlockIds\": [\"20f4dd95-70c7-707b-84a2-7655261b6e2a\"]\n        },\n        {\n          \"text\": \"It teaches not only how enduring riches come, but how they are maintained.\",\n          \"sourceBlockIds\": [\"20f4dd95-70c7-707b-84a2-7655261b6e2a\"]\n        }\n      ]\n    },\n    {\n      \"outlineItemId\": \"01a0e765-16c7-7ed9-a4fe-f24ac7ee6b3b\",\n      \"sentences\": [\n        {\n          \"text\": \"The anchor text is Proverbs 8, where wisdom declares that enduring riches and righteousness travel together.\",\n          \"sourceBlockIds\": [\"cf7d310a-6de0-74c7-ad07-376e2611955f\"]\n        },\n        {\n          \"text\": \"Wisdom says, \\\"I traverse the way of righteousness in the midst of the paths of justice,\\\" to fill the treasuries of those who love God.\",\n          \"sourceBlockIds\": [\"cf7d310a-6de0-74c7-ad07-376e2611955f\"],\n   ","       \"quotation\": true\n        },\n        {\n          \"text\": \"The thesis is simple: spiritual consecration and financial principles belong together.\",\n          \"sourceBlockIds\": [\"20f4dd95-70c7-707b-84a2-7655261b6e2a\"]\n        },\n        {\n          \"text\": \"Wealth that lasts flows along the path of righteousness, not around it.\",\n          \"sourceBlockIds\": [\"cf7d310a-6de0-74c7-ad07-376e2611955f\"]\n        }\n      ]\n    },\n    {\n      \"outlineItemId\": \"01a0e765-16c7-72b7-8b8b-9441d6aa9554\",\n      \"sentences\": [\n        {\n          \"text\": \"Every believer carries two manifestations of righteousness.\",\n          \"sourceBlockIds\": [\"64d91fd4-fd5f-7fe8-adb7-0f9fe209531d\"]\n        },\n        {\n          \"text\": \"The first is righteousness as a gift—positional, received by grace through faith apart from works.\",\n          \"sourceBlockIds\": [\"64d91fd4-fd5f-7fe8-adb7-0f9fe209531d\"]\n        },\n        {\n          \"text\": \"It is a fixed legal credit that cannot increase or diminish.\",\n          \"sourceBlockIds\": [\"64d91fd4-fd5f-7fe8-adb7-0f9fe209531d\"]\n        },\n        {\n          \"text\": \"The second is the harvest of righteousness, which is dynamic and agricultural.\",\n          \"sourceBlockIds\": [\"64d91fd4-fd5f-7fe8-adb7-0f9fe209531d\"]\n        },\n        {\n          \"text\": \"Based on 2 Corinthians 9:10, this harvest is meant to be multiplied through visible works.\",\n          \"sourceBlockIds\": [\"64d91fd4-fd5f-7fe8-adb7-0f9fe209531d\"]\n        }\n      ]\n    },\n    {\n      \"outlineItemId\": \"01a0e765-16c7-781c-9aa5-a4e9164c6898\",\n      \"sentences\": [\n        {\n          \"text\": \"The David analogy makes this distinction memorable.\",\n          \"sourceBlockIds\": [\"7ca0a956-373a-7896-8a32-456f0344144c\"]\n        },\n        {\n          \"text\": \"Before Goliath, David stood on covenant faith; before King Saul, he pointed to visible evidence—the lion and the bear.\",\n          \"sourceBlockIds\": [\"7ca0a956-373a-7896-8a32-456f0344144c\"]\n        },\n        {\n          \"text\": \"Before G","od we present only faith and Christ's finished work.\",\n          \"sourceBlockIds\": [\"7ca0a956-373a-7896-8a32-456f0344144c\"]\n        },\n        {\n          \"text\": \"Before people there must be a visible harvest of works.\",\n          \"sourceBlockIds\": [\"7ca0a956-373a-7896-8a32-456f0344144c\"]\n        }\n      ]\n    },\n    {\n      \"outlineItemId\": \"01a0e765-16c7-77f4-b211-3581eaa65f17\",\n      \"sentences\": [\n        {\n          \"text\": \"In 2 Corinthians 9, Paul ties righteousness directly to generosity.\",\n          \"sourceBlockIds\": [\"3097b16a-81ed-7e14-bbd1-4372ac5d2a9f\"]\n        },\n        {\n          \"text\": \"True giving is a willing, cheerful overflow, not reluctant compulsion.\",\n          \"sourceBlockIds\": [\"3097b16a-81ed-7e14-bbd1-4372ac5d2a9f\"]\n        },\n        {\n          \"text\": \"\\\"Sowing sparingly\\\" describes the heart, not just the amount.\",\n          \"sourceBlockIds\": [\"3097b16a-81ed-7e14-bbd1-4372ac5d2a9f\"]\n        },\n        {\n          \"text\": \"The Hebrew word Tzedakah unifies personal morality, justice, and charity into one whole.\",\n          \"sourceBlockIds\": [\"404cff6f-4c0d-7875-aabb-96f0685d45bf\"]\n        },\n        {\n          \"text\": \"Giving to the poor is classified as justice, not optional benevolence.\",\n          \"sourceBlockIds\": [\"ec9b23ad-0dca-7100-bce3-f16c42945ec8\"]\n        }\n      ]\n    },\n    {\n      \"outlineItemId\": \"01a0e765-16c7-768d-8169-0834f94dde9f\",\n      \"sentences\": [\n        {\n          \"text\": \"Kingdom economics contradicts self-serving worldly models.\",\n          \"sourceBlockIds\": [\"42f96242-5b50-77b4-8fd1-30435834ce62\"]\n        },\n        {\n          \"text\": \"Biblical law required returning a debtor's cloak before sundown—fairness over legal rights.\",\n          \"sourceBlockIds\": [\"f652082f-4c61-7679-b7d2-27068503afdb\"]\n        },\n        {\n          \"text\": \"Debts were canceled every seven years, and lenders were warned not to refuse help as the year approached.\",\n          \"sourceBlockIds\": [\"44ce8e2d-3a2d-777b-a799-cba92010f","a0e\"]\n        },\n        {\n          \"text\": \"Harvesters left gleanings at field edges for the poor, building a safety net into profit.\",\n          \"sourceBlockIds\": [\"36d4fba2-2fdd-71d4-bfb0-939d0f3f07cb\"]\n        },\n        {\n          \"text\": \"Workers were paid promptly, and exploiting another's desperation for a bargain was forbidden.\",\n          \"sourceBlockIds\": [\"872dd57d-4efe-7581-a110-756d73a46531\", \"69bd5311-e0ef-7811-972d-636ddf04576f\"]\n        }\n      ]\n    },\n    {\n      \"outlineItemId\": \"01a0e765-16c7-7316-b443-821fd681c983\",\n      \"sentences\": [\n        {\n          \"text\": \"Divine power must be paired with divine wisdom.\",\n          \"sourceBlockIds\": [\"41b9c1a2-cec3-77bc-b26c-81c618410943\"]\n        },\n        {\n          \"text\": \"Jethro warned Moses that raw power without structure leads to burnout.\",\n          \"sourceBlockIds\": [\"41b9c1a2-cec3-77bc-b26c-81c618410943\"]\n        },\n        {\n          \"text\": \"In Mark 5, Jesus raised a girl from the dead, then immediately ordered food for her.\",\n          \"sourceBlockIds\": [\"d2b8afef-14c7-762a-b8dd-bed047765d37\"]\n        },\n        {\n          \"text\": \"Power restores; wisdom keeps alive.\",\n          \"sourceBlockIds\": [\"702499e4-83e0-7303-8531-e912d1797a5a\"]\n        },\n        {\n          \"text\": \"God gives the power to get wealth, making us managers, not owners.\",\n          \"sourceBlockIds\": [\"c705e30a-effc-72e7-ae8b-ea6561e3dd05\", \"56da342f-cd42-7d37-b7b6-b768bb0be721\"]\n        },\n        {\n          \"text\": \"He demands accountability, as the Parable of the Talents illustrates.\",\n          \"sourceBlockIds\": [\"110b3fc0-2a5e-77ec-bf76-a9b7eefe2cfc\"]\n        }\n      ]\n    },\n    {\n      \"outlineItemId\": \"01a0e765-16c7-7155-a887-59b1b4a849e2\",\n      \"sentences\": [\n        {\n          \"text\": \"Five pillars maintain financial faithfulness.\",\n          \"sourceBlockIds\": [\"4815b8fc-21a8-7fa7-8917-c12836453d01\"]\n        },\n        {\n          \"text\": \"Budgeting uses the 50/30/20 rule: needs, wants, savings and ","investment.\",\n          \"sourceBlockIds\": [\"8449a61b-2d1e-76ed-be02-541cc56685d0\", \"50bd8db7-41bd-7913-8a90-90a7aced7a8a\", \"22956c78-3a4a-7258-bb87-a6fb9df00ff3\", \"8f05cfb9-f4ee-78c4-991b-46b76bd198ea\"]\n        },\n        {\n          \"text\": \"Protection includes health insurance, vehicle insurance, and a three-to-six-month emergency fund.\",\n          \"sourceBlockIds\": [\"1af98d1e-c861-7054-82c0-a77a3a35b7af\", \"4f3fd2ef-56e4-7524-95e3-36c4a0df3406\", \"58cdc1bb-5be1-7589-b504-3dbaf2dd72d3\", \"07b68fb5-f47f-7e7a-b83e-9edc8f0616d2\"]\n        },\n        {\n          \"text\": \"Savings gather like the ant for future opportunities.\",\n          \"sourceBlockIds\": [\"f7a0dee0-73dd-7342-811e-39c6595c7e54\"]\n        },\n        {\n          \"text\": \"Investment requires knowledge and due diligence first.\",\n          \"sourceBlockIds\": [\"7f04f8d6-c813-7458-b704-27ca5825cd30\"]\n        },\n        {\n          \"text\": \"Debt management demands a clear payback plan, for the borrower is servant to the lender.\",\n          \"sourceBlockIds\": [\"16dd3981-b8c6-7944-9679-ceab8d99a408\"]\n        }\n      ]\n    },\n    {\n      \"outlineItemId\": \"01a0e765-16c7-7cc4-9239-445cb073dc7f\",\n      \"sentences\": [\n        {\n          \"text\": \"Enduring riches flow along the path of righteousness.\",\n          \"sourceBlockIds\": [\"cf7d310a-6de0-74c7-ad07-376e2611955f\"]\n        },\n        {\n          \"text\": \"They are received as a gift, demonstrated as a harvest, and expressed through Tzedakah generosity and Kingdom economic structures.\",\n          \"sourceBlockIds\": [\"64d91fd4-fd5f-7fe8-adb7-0f9fe209531d\", \"404cff6f-4c0d-7875-aabb-96f0685d45bf\", \"42f96242-5b50-77b4-8fd1-30435834ce62\"]\n        },\n        {\n          \"text\": \"They are maintained when God's power is matched with wisdom, stewardship, and the five practical pillars.\",\n          \"sourceBlockIds\": [\"41b9c1a2-cec3-77bc-b26c-81c618410943\", \"c705e30a-effc-72e7-ae8b-ea6561e3dd05\", \"4815b8fc-21a8-7fa7-8917-c12836453d01\"]\n        }\n      ]\n    }\n  ]\n}"],"textChunksTruncated":false,"textCharacters":9980,"reasoningCharacters":0,"finishReason":"stop","inputTokens":"[REDACTED]","outputTokens":"[REDACTED]"},"retries":0,"latencyMs":28559,"service":"pipeline-worker","correlationId":"01a0e75e-88f5-767d-995d-992f5f3a4ce4"}}
