{"timestamp":"2026-09-29T11:39:35.533Z","level":"info","event":"queue.job_dispatched","fields":{"outboxEventId":"01a0ecf6-7bcd-78ea-a923-421302ead0bb","jobId":"01a0ecf6-7bcd-7b1c-bf1e-f9c66789c436","projectId":"01a0ecdc-8067-7926-814a-84d1a29920a5","correlationId":"01a0ece2-fd2f-7533-9408-bed00830d7cb","queueName":"orchestration","service":"pipeline-worker"}}
{"timestamp":"2026-09-29T11:39:38.904Z","level":"info","event":"provider.together.response","fields":{"provider":"together","endpoint":"/chat/completions","response":{"httpStatus":200,"contentType":"text/event-stream","providerRequestId":"07bc220a-aws_ec1","model":"moonshotai/Kimi-K3","text":"{\"repairs\":[{\"blockIndex\":4,\"sentenceIndex\":4,\"sentences\":[{\"text\":\"Some symptoms should never wait. Call right away for heavy bleeding or severe abdominal pain. The same goes for a bad headache, changes in your vision, chest pain, or trouble breathing. Sudden swelling in your face or hands, fluid leaking, a clear drop in your baby's movement, or any thoughts of harming yourself also need an immediate call.\"}]},{\"blockIndex\":4,\"sentenceIndex\":6,\"sentences\":[{\"text\":\"When everyone around you weighs in, from social media feeds to family group chats, the mixed messages can leave you more confused than informed. So simplify things. Let one clinician you trust and one solid evidence-based source guide your medical decisions. Treat online communities as a place for encouragement and shared stories, not for figuring out what is wrong.\"}]},{\"blockIndex\":5,\"sentenceIndex\":4,\"sentences\":[{\"text\":\"For birth, these muscles have to be strong, but they also have to let go. That is why Kegels alone do not cover it. In fact, if your pelvic floor is already overactive or tight, extra squeezing can add to the problem rather than solve it.\"}]},{\"blockIndex\":6,\"sentenceIndex\":4,\"sentences\":[{\"text\":\"Getting ready means thinking beyond the baby gear. It means planning for how you will heal, how broken your sleep may be, and the hormonal shifts ahead. It also means lining up meals, hands-on help, and people who can be there for you emotionally.\"}]},{\"blockIndex\":6,\"sentenceIndex\":5,\"sentences\":[{\"text\":\"Keep the routine light. Each week, pick just one doable task. That might be sketching out a meal plan. Or talking through how your partner or family will pitch in. It could be setting aside comfortable postpartum clothes. Or deciding who you will call when a hard day hits.\"}]}]}","textChunks":["{\"repairs\":[{\"blockIndex\":4,\"sentenceIndex\":4,\"sentences\":[{\"text\":\"Some symptoms should never wait. Call right away for heavy bleeding or severe abdominal pain. The same goes for a bad headache, changes in your vision, chest pain, or trouble breathing. Sudden swelling in your face or hands, fluid leaking, a clear drop in your baby's movement, or any thoughts of harming yourself also need an immediate call.\"}]},{\"blockIndex\":4,\"sentenceIndex\":6,\"sentences\":[{\"text\":\"When everyone around you weighs in, from social media feeds to family group chats, the mixed messages can leave you more confused than informed. So simplify things. Let one clinician you trust and one solid evidence-based source guide your medical decisions. Treat online communities as a place for encouragement and shared stories, not for figuring out what is wrong.\"}]},{\"blockIndex\":5,\"sentenceIndex\":4,\"sentences\":[{\"text\":\"For birth, these muscles have to be strong, but they also have to let go. That is why Kegels alone do not cover it. In fact, if your pelvic floor is already overactive or tight, extra squeezing can add to the problem rather than solve it.\"}]},{\"blockIndex\":6,\"sentenceIndex\":4,\"sentences\":[{\"text\":\"Getting ready means thinking beyond the baby gear. It means planning for how you will heal, how broken your sleep may be, and the hormonal shifts ahead. It also means lining up meals, hands-on help, and people who can be there for you emotionally.\"}]},{\"blockIndex\":6,\"sentenceIndex\":5,\"sentences\":[{\"text\":\"Keep the routine light. Each week, pick just one doable task. That might be sketching out a meal plan. Or talking through how your partner or family will pitch in. It could be setting aside comfortable postpartum clothes. Or deciding who you will call when a hard day hits.\"}]}]}"],"textChunksTruncated":false,"textCharacters":1786,"reasoningCharacters":0,"finishReason":"stop","inputTokens":"[REDACTED]","outputTokens":"[REDACTED]"},"retries":0,"latencyMs":7442,"service":"pipeline-worker","correlationId":"01a0ece2-fd2f-7533-9408-bed00830d7cb"}}
