{"timestamp":"2026-09-29T11:41:00.013Z","level":"info","event":"provider.together.response","fields":{"provider":"together","endpoint":"/chat/completions","response":{"httpStatus":200,"contentType":"text/event-stream","providerRequestId":"02104e43-aws_ec1","model":"moonshotai/Kimi-K3","text":"{\"repairs\":[{\"blockIndex\":4,\"sentenceIndex\":5,\"sentences\":[{\"text\":\"Get care right away for heavy bleeding, severe pain in your abdomen, or a bad headache that will not let up.\"},{\"text\":\"The same goes for changes in your vision, chest pain, or trouble breathing.\"},{\"text\":\"Also report sudden puffiness in your face or hands, fluid leaking, your baby moving much less than usual, or any thoughts of harming yourself.\"}]}]}","textChunks":["{\"repairs\":[{\"blockIndex\":4,\"sentenceIndex\":5,\"sentences\":[{\"text\":\"Get care right away for heavy bleeding, severe pain in your abdomen, or a bad headache that will not let up.\"},{\"text\":\"The same goes for changes in your vision, chest pain, or trouble breathing.\"},{\"text\":\"Also report sudden puffiness in your face or hands, fluid leaking, your baby moving much less than usual, or any thoughts of harming yourself.\"}]}]}"],"textChunksTruncated":false,"textCharacters":423,"reasoningCharacters":0,"finishReason":"stop","inputTokens":"[REDACTED]","outputTokens":"[REDACTED]"},"retries":0,"latencyMs":2297,"service":"pipeline-worker","correlationId":"01a0ece2-fd2f-7533-9408-bed00830d7cb"}}
